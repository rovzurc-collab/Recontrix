                                dailyDeposit[index] += Math.abs(parseTxnAmount(day.deposit_amount || 0));
                                dailyWithdrawal[index] += Math.abs(parseTxnAmount(day.withdrawal_amount || 0));
                            });
                        }

                        monthCursor.setMonth(monthCursor.getMonth() + 1);
                    }

                    console.log('📊 Transaction analysis fallback from monthly_report applied', {
                        deposit: dailyDeposit.reduce((sum, value) => sum + value, 0),
                        withdrawal: dailyWithdrawal.reduce((sum, value) => sum + value, 0)
                    });
