                    </tbody>
                    <tfoot id="walletTableFooter">
                        <tr style="background:#FFE5CC;">
                            <td style="color:#0b2d6b; font-weight:normal;">Total Balance</td>
                            <td class="table-balance" style="font-weight:normal;">0</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="chart-card">
                <div class="chart-title" id="walletChartTitle">Wallet</div>
                <div class="chart-canvas">
                    <canvas id="walletChart"></canvas>
                </div>
