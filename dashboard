        async function saveTransaction(row, type) {
            const cells = row.querySelectorAll('td');
            const transactionId = row.dataset.transactionId;
            const sourceFile = row.dataset.sourceFile;
            const tableType = row.dataset.tableType || type;
            const isCombined = row.dataset.combined === 'true';
            const gatewayId = row.dataset.gatewayId;
            const backofficeId = row.dataset.backofficeId;
            const gatewayTableType = row.dataset.gatewayTableType || tableType;
            const backofficeTableType = row.dataset.backofficeTableType || tableType;
            
            if (type === 'adjustment') {
                // Handle adjustment updates
                const updatedData = {
                    id: transactionId,
                    wallet: cells[3].querySelector('input').value.trim().toUpperCase(),
                    shop: cells[4].querySelector('input').value.trim().toUpperCase(),
                    amount: parseFloat(cells[5].querySelector('input').value),
                    fee: parseFloat(cells[6].querySelector('input').value) || 0,
                    type: cells[7].querySelector('select').value,
                    gateway_date: cells[8].querySelector('input').value,
                    remarks: cells[9].querySelector('input').value.trim().toUpperCase()
                };
                
                // Validate
                if (!updatedData.amount || updatedData.amount <= 0) {
                    alert('Amount is required and must be greater than 0!');
                    return;
                }
                
                try {
                    const response = await fetch('/api/update_adjustment', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(updatedData)
                    });
                    
                    if (!response.ok) {
                        const errorText = await response.text();
                        throw new Error(`HTTP ${response.status}: ${errorText.substring(0, 100)}`);
                    }
                    
                    const result = await response.json();
                    if (!result.success) {
                        alert('Error updating adjustment: ' + result.message);
                        return;
                    }
                    
                    alert('Adjustment updated successfully!');
                    row.classList.remove('editing');
                    await loadTransactions('adjustment');
                } catch (error) {
                    alert('Error: ' + error.message);
                }
                return;
            }
            
            // Handle deposit/withdrawal updates
            const updatedData = {
                id: transactionId,
                type: tableType,
                source_file: sourceFile,
                wallet: cells[3].querySelector('input').value.trim().toUpperCase(),
                transaction_id: cells[4].querySelector('input').value.trim().toUpperCase(),
                reference_number: cells[5].querySelector('input').value.trim().toUpperCase(),
                shop: cells[6].querySelector('input').value.trim().toUpperCase(),
                amount: parseFloat(cells[7].querySelector('input').value),
                fee: parseFloat(cells[8].querySelector('input').value) || 0,
                status: cells[9].querySelector('select').value,
                gateway_date: cells[10].querySelector('input').value,
                backoffice_date: cells[11].querySelector('input').value
            };
            
            // Validate
            if (!updatedData.transaction_id || !updatedData.amount) {
                alert('Transaction ID and Amount are required!');
