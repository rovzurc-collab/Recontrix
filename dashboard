                        }
                        
                        console.log('[updateKPIValues] API data applied successfully');
                        return;
                    } else {
                        console.error('[updateKPIValues] API returned success=false:', result);
                    }
                } catch (err) {
                    console.error('[updateKPIValues] API call failed:', err);
                }
                // If API fails for full month, don't use local calculation
                console.warn('[updateKPIValues] API failed, showing stale data');
