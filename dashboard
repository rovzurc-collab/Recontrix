            canAccessBrand: function(brandName) {
                if (this.isAdmin) return true;
                if (this.allowedBrands.length === 0) return true; // No restrictions = all allowed
                return this.allowedBrands.some(b => b.toUpperCase() === (brandName || '').toUpperCase());
