        </div> <!-- end dashboard section -->

        <!-- MONTHLY REPORT SECTION -->
        <div class="section" data-section="report">
            <h2 style="color:#001a3d; font-size:20px; font-weight:600; letter-spacing:0.5px; text-align:left; margin-bottom:20px; text-transform:uppercase;">{{ t('monthly_report', language) }}</h2>
            <div class="search-panel" style="background:#d9ecf7; padding:20px; border-radius:8px; margin-bottom:20px;">
                <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:15px; margin-bottom:15px;">
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Month</label>
                        <select id="monthlyReportMonth" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
