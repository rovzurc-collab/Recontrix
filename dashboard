                        // Check if gateway is allowed
                        const optionKey = normalizeGatewayKey(`${optionCurrency}::${gatewayValue}`);
                        const fallbackKey = normalizeGatewayKey(gatewayValue);
                        const isAllowed = allowedGatewaySet.has(optionKey) || allowedGatewaySet.has(fallbackKey);
                        
