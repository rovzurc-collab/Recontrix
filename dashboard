            const totalBalance = gatewayEntries.reduce((sum, [, value]) => sum + Math.abs(value), 0);

            gatewayGraph.innerHTML = gatewayEntries.map(([gateway, value]) => {
                const percent = totalBalance > 0 ? (Math.abs(value) / totalBalance) * 100 : 0;
                const safePercent = Math.max(0, Math.min(100, percent));
                const formattedBalance = value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
