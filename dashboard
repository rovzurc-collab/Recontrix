        function updateClosingBalanceKpis() {
            const fromValue = document.getElementById('dashboardDateFrom')?.value || '';
            const toValue = document.getElementById('dashboardDateTo')?.value || '';
            const brandFilter = normalizeFilterValue(document.getElementById('dashboardBrandSelect')?.value || '');
            const currencyFilter = normalizeFilterValue(document.getElementById('dashboardCurrencySelect')?.value || '');
            const gatewayFilter = normalizeFilterValue(document.getElementById('dashboardGatewaySelect')?.value || '');

            const fromDate = fromValue ? new Date(fromValue + 'T00:00:00') : null;
            const toDate = toValue ? new Date(toValue + 'T23:59:59') : null;
            const targetDate = toDate || new Date();
            const targetKey = targetDate.toISOString().slice(0, 10);

            const daily = {};
            const ensureDay = (key) => {
                if (!daily[key]) {
                    daily[key] = {
                        deposit: 0,
                        withdrawal: 0,
                        fundTransferIn: 0,
                        fundTransferOut: 0,
                        specialPayment: 0,
                        settlement: 0,
                        fee: 0,
                        adjustmentIn: 0,
                        adjustmentOut: 0,
                        commission: 0,
                        securityDeposit: 0
                    };
                }
            };

            const inRange = (dateObj) => {
                if (!dateObj) return false;
                if (fromDate && dateObj < fromDate) return false;
                if (toDate && dateObj > toDate) return false;
                return true;
            };

            const isBeforeRange = (dateObj) => {
                if (!dateObj) return false;
                return !!(fromDate && dateObj < fromDate);
            };
            
            // Check if originalTransactionData is available
            if (!window.originalTransactionData && typeof originalTransactionData === 'undefined') {
                console.log('WARNING: originalTransactionData not available yet for KPIs');
                return;
            }
            
            const txData = window.originalTransactionData || originalTransactionData;

            (txData.deposit || []).forEach(tx => {
                if (tx.source_file === 'BACKOFFICE' || tx.source_file === 'COMBINED') return;
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (currencyFilter && normalizeFilterValue(tx.currency) !== currencyFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;

                const dateObj = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                if (!inRange(dateObj) && !isBeforeRange(dateObj)) return;

                const key = dateObj.toISOString().slice(0, 10);
                ensureDay(key);
                daily[key].deposit += parseFloat(tx.amount || 0);
            });

            (txData.withdrawal || []).forEach(tx => {
                if (tx.source_file === 'BACKOFFICE' || tx.source_file === 'COMBINED') return;
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (currencyFilter && normalizeFilterValue(tx.currency) !== currencyFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;

                const dateObj = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                if (!inRange(dateObj) && !isBeforeRange(dateObj)) return;

                const key = dateObj.toISOString().slice(0, 10);
                ensureDay(key);
                daily[key].withdrawal += parseFloat(tx.amount || 0);
            });

            (txData.adjustment || []).forEach(tx => {
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (currencyFilter && normalizeFilterValue(tx.currency) !== currencyFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;

                const dateObj = parseTxnDate(tx.gateway_date || '');
                if (!inRange(dateObj) && !isBeforeRange(dateObj)) return;

                const key = dateObj.toISOString().slice(0, 10);
                ensureDay(key);

                const adjType = normalizeFilterValue(tx.type);
                const amount = parseFloat(tx.amount || 0);

                if (adjType.includes('fund transfer in')) {
                    daily[key].fundTransferIn += amount;
                } else if (adjType.includes('fund transfer out')) {
                    daily[key].fundTransferOut -= amount;
                } else if (adjType.includes('special payment')) {
                    daily[key].specialPayment -= amount;
                } else if (adjType.includes('settlement')) {
                    daily[key].settlement -= amount;
                } else if (adjType === 'fee' || adjType.includes('fee')) {
                    daily[key].fee -= amount;
                } else if (adjType.includes('adjustment in')) {
                    daily[key].adjustmentIn += amount;
                } else if (adjType.includes('adjustment out')) {
                    daily[key].adjustmentOut -= amount;
                } else if (adjType.includes('commission')) {
                    daily[key].commission -= amount;
                } else if (adjType.includes('security deposit')) {
                    daily[key].securityDeposit += amount;
                }
            });

            let runningBalance = 0;
            let totalSecurityDeposit = 0;
            const keys = Object.keys(daily).sort();
            keys.forEach(key => {
                if (key > targetKey) return;
                const d = daily[key];
                runningBalance = runningBalance + d.deposit - d.withdrawal + d.fundTransferIn + d.fundTransferOut +
                    d.specialPayment + d.settlement + d.fee + d.adjustmentIn + d.adjustmentOut + d.commission;
                totalSecurityDeposit += d.securityDeposit;
            });

            const kpiBalanceValue = document.getElementById('kpiBalanceValue');
            if (kpiBalanceValue) {
                kpiBalanceValue.textContent = runningBalance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            const kpiSecurityValue = document.getElementById('kpiSecurityValue');
            if (kpiSecurityValue) {
                kpiSecurityValue.textContent = totalSecurityDeposit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
        }
        
        async function updateKPIValues() {
            console.log('[updateKPIValues] Starting KPI update...');
            
            const fromValue = document.getElementById('dashboardDateFrom')?.value || '';
            const toValue = document.getElementById('dashboardDateTo')?.value || '';
