            const prevBtn = document.getElementById('shopBalancePrevPage');
            const nextBtn = document.getElementById('shopBalanceNextPage');

            if (entriesSelect && !entriesSelect.dataset.bound) {
                entriesSelect.value = String(window.shopBalanceEntriesPerPage || 100);
                entriesSelect.addEventListener('change', () => {
                    window.shopBalanceEntriesPerPage = parseInt(entriesSelect.value, 10) || 100;
                    window.shopBalanceCurrentPage = 1;
                    renderShopBalanceTable();
                });
                entriesSelect.dataset.bound = '1';
            }

            if (prevBtn && !prevBtn.dataset.bound) {
                prevBtn.addEventListener('click', () => {
                    if (window.shopBalanceCurrentPage > 1) {
                        window.shopBalanceCurrentPage -= 1;
                        renderShopBalanceTable();
                    }
                });
                prevBtn.dataset.bound = '1';
            }

            if (nextBtn && !nextBtn.dataset.bound) {
                nextBtn.addEventListener('click', () => {
                    const total = Array.isArray(window.shopBalanceResults) ? window.shopBalanceResults.length : 0;
                    const totalPages = Math.max(1, Math.ceil(total / (window.shopBalanceEntriesPerPage || 100)));
                    if (window.shopBalanceCurrentPage < totalPages) {
                        window.shopBalanceCurrentPage += 1;
                        renderShopBalanceTable();
                    }
                });
                nextBtn.dataset.bound = '1';
            }

            document.querySelectorAll('#shopBalanceTable thead th.sortable').forEach(th => {
                if (th.dataset.bound) return;
                th.addEventListener('click', () => setShopBalanceSort(th.getAttribute('data-sort-key') || ''));
                th.dataset.bound = '1';
            });

            renderShopBalanceTable();
        }

        function getShopBalanceKey(brand, gateway, currency, shop) {
            return [
                normalizeFilterValue(brand),
                normalizeFilterValue(gateway),
                normalizeFilterValue(currency),
                normalizeFilterValue(shop)
            ].join('|||');
        }

        function getShopBalanceMonthRange() {
            const month = document.getElementById('shopBalanceMonth')?.value || '01';
            const year = document.getElementById('shopBalanceYear')?.value || String(new Date().getFullYear());
            const fromDate = new Date(parseInt(year, 10), parseInt(month, 10) - 1, 1, 0, 0, 0);
            const toDate = new Date(parseInt(year, 10), parseInt(month, 10), 0, 23, 59, 59);
            return { fromDate, toDate };
        }

        function parseCsvLine(line) {
            const values = [];
            let value = '';
            let inQuotes = false;
            for (let i = 0; i < line.length; i++) {
                const char = line[i];
                if (char === '"') {
                    if (inQuotes && line[i + 1] === '"') {
                        value += '"';
                        i++;
                    } else {
                        inQuotes = !inQuotes;
                    }
                } else if (char === ',' && !inQuotes) {
                    values.push(value.trim());
                    value = '';
                } else {
                    value += char;
                }
            }
            values.push(value.trim());
            return values;
        }

        function downloadShopBalanceTemplate() {
            const header = ['Brand', 'Gateway', 'Currency', 'Team Leader', 'Group', 'Shop'];
            const sample1 = ['BADSHA', 'BKASH', 'BDT', 'TL-01', 'GRP-A', 'Shop A'];
            const sample2 = ['BAJI', 'NAGAD', 'BDT', 'TL-02', 'GRP-B', 'Shop B'];
            const csv = [header.join(','), sample1.join(','), sample2.join(',')].join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = 'shop_balance_template.csv';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

