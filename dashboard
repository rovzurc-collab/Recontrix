                </div>
                <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:15px; margin-bottom:15px;">
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Brand</label>
                        <select id="monthlyReportBrand" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
