            // For non-full-month ranges or when no dates selected, use local calculation
            console.log('[updateKPIValues] Using local calculation (not full month)');
            
            // Calculate gateway-only data with date filtering (exclude BACKOFFICE and COMBINED)
            const calculateGatewayTotals = (transactions) => {
                let total = 0, count = 0;
                let matched = 0, wrongAmount = 0, unclaimed = 0, gatewayDup = 0;
                
                (transactions || []).forEach(tx => {
                    // Only include gateway records (not BACKOFFICE or COMBINED)
                    if (tx.source_file === 'BACKOFFICE' || tx.source_file === 'COMBINED') return;
                    
                    if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                    if (currencyFilter && normalizeFilterValue(tx.currency) !== currencyFilter) return;
                    if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;

                    // Apply date range filtering
                    const txDate = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                    if (fromDate && txDate && txDate < fromDate) return;
                    if (toDate && txDate && txDate > toDate) return;
                    
                    const amount = parseFloat(tx.amount || 0);
                    const status = (tx.status || '').toLowerCase();
                    
                    // Count ALL gateway transactions regardless of status
                    total += amount;
                    count++;
                    
                    // Also track by status for breakdown
                    if (status === 'matched' || status.includes('matched (')) {
                        matched += amount;
                    } else if (status === 'unclaimed') {
                        unclaimed += amount;
                    }
