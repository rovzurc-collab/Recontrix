                .map(([gateway, value]) => [gateway, Number(value) || 0])
                .filter(([_, value]) => Math.abs(value) >= 0.1)
                .sort((a, b) => Math.abs(b[1]) - Math.abs(a[1]));
            
            console.log('💰 Final gateway entries:', gatewayEntries);
            
