                    sample: []
                };

                const addTx = (tx, type) => {
                    if (!isGatewayTransaction(tx)) return;
                    if (normalizedCurrency && normalizeFilterValue(tx.currency || '') !== normalizedCurrency) return;
                    if (normalizedBrand && normalizeFilterValue(tx.brand || '') !== normalizedBrand) return;

                    const key = normalizeGatewayDateKey(tx.gateway_date || tx.backoffice_date || '');
                    if (key !== normalizedDateKey) return;

                    const amount = Math.abs(parseTxnAmount(tx.amount));
                    const gatewayName = resolveGatewayName(tx) || '(unknown)';
                    const bucket = type === 'deposit' ? results.depositByGateway : results.withdrawalByGateway;

                    bucket[gatewayName] = (bucket[gatewayName] || 0) + amount;
                    if (type === 'deposit') {
                        results.depositTotal += amount;
                        results.depositCount += 1;
                    } else {
                        results.withdrawalTotal += amount;
                        results.withdrawalCount += 1;
                    }

                    if (results.sample.length < 25) {
                        results.sample.push({
                            type,
                            amount,
                            gateway: gatewayName,
                            source_file: tx.source_file || '',
                            gateway_date: tx.gateway_date || '',
                            currency: tx.currency || '',
                            brand: tx.brand || ''
                        });
                    }
                };

                (txData.deposit || []).forEach(tx => addTx(tx, 'deposit'));
                (txData.withdrawal || []).forEach(tx => addTx(tx, 'withdrawal'));

                console.log('Transaction analysis debug', results);
                return results;
            };

            const localDepositTotal = dailyDeposit.reduce((sum, value) => sum + value, 0);
            const localWithdrawalTotal = dailyWithdrawal.reduce((sum, value) => sum + value, 0);

            const formatAmountFull = (value) => Number(value || 0).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            const getGatewayList = () => {
                const configured = (window.gatewaysDataByManageList?.[currencyValue] || [])
                    .map((item) => {
                        if (typeof item === 'string') return item;
                        if (item && typeof item === 'object') {
                            return item.name || item.gateway || item.label || item.value;
                        }
                        return '';
                    })
                    .filter(Boolean);

                const list = [];
                const seen = new Set();

                configured.forEach((name) => {
                    const key = normalizeGatewayKey(name);
                    if (!key || seen.has(key)) return;
                    seen.add(key);
                    list.push({ key, label: name });
                });

                Array.from(gatewaySet).forEach((key) => {
                    if (!key || seen.has(key)) return;
                    seen.add(key);
                    list.push({ key, label: gatewayDisplayByKey[key] || key });
                });

                return list;
            };

            const buildGatewayBreakdownLines = (isDeposit, dateKey) => {
                const gateways = getGatewayList();
                if (gateways.length === 0) return [];
                const dateTotals = isDeposit
                    ? (perDateGatewayTotals.deposit[dateKey] || {})
                    : (perDateGatewayTotals.withdrawal[dateKey] || {});
                return gateways.map((gateway) => {
                    const amount = dateTotals[gateway.key] || 0;
                    return `${gateway.label}: ${formatAmountFull(amount)}`;
                });
            };

            if (localDepositTotal === 0 && localWithdrawalTotal === 0) {
                try {
                    const monthCursor = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
                    const monthEnd = new Date(endDate.getFullYear(), endDate.getMonth(), 1);

                    while (monthCursor <= monthEnd) {
                        const month = String(monthCursor.getMonth() + 1).padStart(2, '0');
                        const year = String(monthCursor.getFullYear());

                        const response = await fetch('/api/monthly_report', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                month,
                                year,
                                currency: normalizedCurrency ? normalizedCurrency.toUpperCase() : '',
                                brand: normalizedBrand ? normalizedBrand.toUpperCase() : '',
                                gateway: normalizedGateway ? normalizedGateway.toUpperCase() : '',
                                wallet: '',
