            console.log('[updateKPIValues] Filters:', { fromValue, toValue, brandFilter, currencyFilter, gatewayFilter });

            const fromDate = fromValue ? new Date(fromValue + 'T00:00:00') : null;
            const toDate = toValue ? new Date(toValue + 'T23:59:59') : null;

            const isFullMonthRange = (start, end) => {
                if (!start || !end) return false;
                if (start.getFullYear() !== end.getFullYear()) return false;
                if (start.getMonth() !== end.getMonth()) return false;
                if (start.getDate() !== 1) return false;
                const lastDay = new Date(end.getFullYear(), end.getMonth() + 1, 0).getDate();
                return end.getDate() === lastDay;
            };

            const isSameDateRange = (start, end) => {
                // Detect if dates are in same month (even single day or partial month)
                if (!start || !end) return false;
                return start.getFullYear() === end.getFullYear() && start.getMonth() === end.getMonth();
            };

            const isMultiMonthRange = (start, end) => {
                // Detect if dates span multiple months
                if (!start || !end) return false;
                return start.getFullYear() !== end.getFullYear() || start.getMonth() !== end.getMonth();
            };

            const isFullMonth = isFullMonthRange(fromDate, toDate);
            const sameMonth = isSameDateRange(fromDate, toDate);
            const multiMonth = isMultiMonthRange(fromDate, toDate);
            console.log('[updateKPIValues] Full month:', isFullMonth, 'Same month:', sameMonth, 'Multi-month:', multiMonth);

            // ============================================================================
            // MULTI-MONTH RANGE (e.g., Jan 1 to Feb 12) - Fetch ALL months, then filter
            // ============================================================================
            if (multiMonth) {
                console.log('[updateKPIValues] Multi-month range detected - fetching data for all months in range');
                try {
                    let allDailyData = [];
                    
                    // Generate all months between start and end dates
                    const currentMonth = new Date(fromDate);
                    const endMonth = new Date(toDate);
                    
