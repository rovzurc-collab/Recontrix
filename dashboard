                if (normalizeFilterValue(tx.currency || '') !== normalizedCurrency) return;
                if (normalizedBrand && normalizeFilterValue(tx.brand || '') !== normalizedBrand) return;

                const gatewayName = resolveGatewayName(tx);
                if (normalizedGatewayFilter && normalizeFilterValue(gatewayName) !== normalizedGatewayFilter) return;

                const dateObj = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                if (!inRange(dateObj) && !isBeforeRange(dateObj)) return;

                const key = ensureGatewayKey(gatewayName);
                if (!key) return;

                gatewayBalances[key] += parseFloat(tx.amount || 0);
                gatewayBalances[key] -= parseFloat(tx.fee || 0);
            });

            (txData.withdrawal || []).forEach(tx => {
                if (tx.source_file === 'BACKOFFICE') return;
                if (normalizeFilterValue(tx.currency || '') !== normalizedCurrency) return;
                if (normalizedBrand && normalizeFilterValue(tx.brand || '') !== normalizedBrand) return;

                const gatewayName = resolveGatewayName(tx);
                if (normalizedGatewayFilter && normalizeFilterValue(gatewayName) !== normalizedGatewayFilter) return;

                const dateObj = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                if (!inRange(dateObj) && !isBeforeRange(dateObj)) return;

                const key = ensureGatewayKey(gatewayName);
                if (!key) return;

                gatewayBalances[key] -= parseFloat(tx.amount || 0);
                gatewayBalances[key] -= parseFloat(tx.fee || 0);
            });

            (txData.adjustment || []).forEach(tx => {
                if (normalizeFilterValue(tx.currency || '') !== normalizedCurrency) return;
                if (normalizedBrand && normalizeFilterValue(tx.brand || '') !== normalizedBrand) return;

                const gatewayName = resolveGatewayName(tx);
                if (normalizedGatewayFilter && normalizeFilterValue(gatewayName) !== normalizedGatewayFilter) return;

                const dateObj = parseTxnDate(tx.gateway_date || '');
                if (!inRange(dateObj) && !isBeforeRange(dateObj)) return;

                const key = ensureGatewayKey(gatewayName);
                if (!key) return;

                const adjType = normalizeFilterValue(tx.type || '');
                const amount = parseFloat(tx.amount || 0);

                if (adjType.includes('fund transfer in') || adjType.includes('adjustment in') || adjType.includes('security deposit')) {
                    gatewayBalances[key] += amount;
                } else if (
                    adjType.includes('fund transfer out') ||
                    adjType.includes('adjustment out') ||
                    adjType.includes('special payment') ||
                    adjType.includes('settlement') ||
                    adjType.includes('fee') ||
                    adjType.includes('commission')
                ) {
                    gatewayBalances[key] -= amount;
                }
            });

            console.log('💰 Final gateway balances:', gatewayBalances);
            return gatewayBalances;
        }

