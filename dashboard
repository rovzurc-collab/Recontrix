        function updateStatusBars() {
            // Calculate status percentages from FILTERED transaction data based on dashboard filters
            // Matched = Matched + Wrong Amount
            // Unsettled = Unsettled + Backoffice Duplicated
            // Unclaimed = Unclaimed + Gateway Duplicated
            
            const calculateStatusPercentages = (transactions) => {
                if (!transactions || transactions.length === 0) {
                    return { matched: 0, unsettled: 0, unclaimed: 0 };
                }
                
                let matchedCount = 0;
                let unsettledCount = 0;
                let unclaimedCount = 0;
                
                transactions.forEach(tx => {
                    const status = (tx.status || '').toLowerCase();
                    
                    if (status.includes('matched')) {
                        matchedCount++;
                    } else if (status === 'unsettled' || status === 'backoffice duplicated') {
                        unsettledCount++;
                    } else if (status === 'unclaimed') {
                        unclaimedCount++;
                    }
                });
                
                const total = matchedCount + unsettledCount + unclaimedCount;
                
                if (total === 0) {
                    return { matched: 0, unsettled: 0, unclaimed: 0 };
                }
                
                return {
                    matched: Math.round((matchedCount / total) * 100),
                    unsettled: Math.round((unsettledCount / total) * 100),
                    unclaimed: Math.round((unclaimedCount / total) * 100)
