        function getShopBalanceSortValue(row, key) {
            const numericKeys = new Set([
                'securityDeposit', 'openingBalance', 'totalDeposit', 'totalWithdrawal',
                'totalAdjustment', 'fundTransferIn', 'fundTransferOut', 'specialPayment', 'settlement',
                'fee', 'adjustmentIn', 'adjustmentOut', 'commission', 'closingBalance', 'activeDays'
            ]);

            if (numericKeys.has(key)) {
                return Number(row[key] || 0);
            }
            return String(row[key] || '').toLowerCase();
        }

        function sortShopBalanceRows(rows) {
            const sortKey = window.shopBalanceSortKey || 'closingBalance';
            const sortDirection = window.shopBalanceSortDirection === 'asc' ? 1 : -1;
            return rows.sort((a, b) => {
                const aVal = getShopBalanceSortValue(a, sortKey);
                const bVal = getShopBalanceSortValue(b, sortKey);
                if (typeof aVal === 'number' && typeof bVal === 'number') {
                    return (aVal - bVal) * sortDirection;
                }
                return String(aVal).localeCompare(String(bVal)) * sortDirection;
            });
        }

