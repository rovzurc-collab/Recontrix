                            brand: normalizedBrand ? normalizedBrand.toUpperCase() : '',
                            gateway: String(gatewayName).toUpperCase(),
                            wallet: '',
                            shop: ''
                        })
                    });

                    const result = await response.json();
                    if (!result.success || !Array.isArray(result.data)) {
                        monthCursor.setMonth(monthCursor.getMonth() + 1);
                        continue;
                    }

                    const openingRow = result.data.find(day => day.date === 'Opening Balance');
                    if (!initialized) {
                        runningBalance = Number(openingRow?.running_balance || 0);
                        initialized = true;
                    }

                    result.data.forEach(day => {
                        if (day.date === 'Opening Balance') return;
                        const dayDate = new Date(String(day.date) + 'T00:00:00');
                        if (Number.isNaN(dayDate.getTime())) return;
                        if (dayDate > toDate) return;

                        runningBalance = runningBalance +
                            Number(day.deposit_amount || 0) -
                            Number(day.withdrawal_amount || 0) +
                            Number(day.fund_transfer_in || 0) +
                            Number(day.fund_transfer_out || 0) +
                            Number(day.special_payment || 0) +
                            Number(day.settlement || 0) +
                            Number(day.fee || 0) +
                            Number(day.adjustment_in || 0) +
                            Number(day.adjustment_out || 0) +
                            Number(day.commission || 0);
                    });

                    monthCursor.setMonth(monthCursor.getMonth() + 1);
                }

                return initialized ? runningBalance : null;
            };

            if (normalizedGatewayFilter) {
                try {
                    const apiBalance = await getRunningBalanceFromMonthlyReport();
                    if (apiBalance !== null) {
                        gatewayBalances[selectedGatewayLabel || normalizedGatewayFilter.toUpperCase()] = Number(apiBalance) || 0;
                        console.log('💰 Gateway balance from monthly_report API:', gatewayBalances);
                        return gatewayBalances;
                    }
                } catch (apiError) {
                    console.warn('⚠️ Gateway monthly_report fallback failed, using transaction aggregation:', apiError);
                }
            }

            if (!normalizedGatewayFilter) {
                try {
                    const configuredGateways = (window.gatewaysDataByManageList?.[currency] || [])
                        .map(item => String(item?.name || '').trim())
                        .filter(Boolean);

                    const uniqueGateways = [...new Set(configuredGateways)];
                    if (uniqueGateways.length > 0) {
                        const balances = await Promise.all(
                            uniqueGateways.map(async (gatewayName) => ({
                                gatewayName,
                                balance: await getRunningBalanceForGateway(gatewayName)
                            }))
                        );

                        balances.forEach(item => {
                            if (item.balance !== null) {
                                gatewayBalances[item.gatewayName] = Number(item.balance) || 0;
                            }
                        });

                        if (Object.keys(gatewayBalances).length > 0) {
                            console.log('💰 All-gateways balances from monthly_report API:', gatewayBalances);
                            return gatewayBalances;
