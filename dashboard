        let loginAuditData = [];
        
        function initializeLoginAuditPagination() {
            const tableBody = document.getElementById('loginAuditTableBody');
            if (!tableBody) return;
            
            // Collect all login audit rows
            loginAuditData = Array.from(tableBody.querySelectorAll('tr')).map(row => row.outerHTML);
            
            // Set up pagination controls
            const entriesSelect = document.getElementById('loginAuditEntriesSelect');
            const prevBtn = document.getElementById('loginAuditPrevPage');
            const nextBtn = document.getElementById('loginAuditNextPage');
            
            if (entriesSelect) {
                entriesSelect.addEventListener('change', () => {
                    loginAuditEntriesPerPage = parseInt(entriesSelect.value);
                    loginAuditCurrentPage = 1;
                    renderLoginAuditPage();
                });
            }
            
            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    if (loginAuditCurrentPage > 1) {
                        loginAuditCurrentPage--;
                        renderLoginAuditPage();
                    }
                });
            }
            
            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    const totalPages = Math.ceil(loginAuditData.length / loginAuditEntriesPerPage);
                    if (loginAuditCurrentPage < totalPages) {
                        loginAuditCurrentPage++;
                        renderLoginAuditPage();
                    }
                });
            }
            
            renderLoginAuditPage();
        }
        
        function renderLoginAuditPage() {
            const tableBody = document.getElementById('loginAuditTableBody');
            if (!tableBody) return;
            
            const start = (loginAuditCurrentPage - 1) * loginAuditEntriesPerPage;
            const end = start + loginAuditEntriesPerPage;
            const pageData = loginAuditData.slice(start, end);
            
            tableBody.innerHTML = pageData.join('');
            
            // Update pagination info
            const pageInfo = document.getElementById('loginAuditPageInfo');
            const totalPages = Math.ceil(loginAuditData.length / loginAuditEntriesPerPage) || 1;
            if (pageInfo) {
                const showing = loginAuditData.length === 0 ? 0 : start + 1;
                const showingEnd = Math.min(end, loginAuditData.length);
                pageInfo.textContent = `Showing ${showing}-${showingEnd} of ${loginAuditData.length}`;
            }
            
            // Update buttons
            const prevBtn = document.getElementById('loginAuditPrevPage');
            const nextBtn = document.getElementById('loginAuditNextPage');
            if (prevBtn) prevBtn.disabled = loginAuditCurrentPage <= 1;
            if (nextBtn) nextBtn.disabled = loginAuditCurrentPage >= totalPages;
        }
        
        // Initialize login audit pagination on page load
        if (document.getElementById('loginAuditTableBody')) {
