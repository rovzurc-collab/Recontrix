        <div class="modal-content" style="max-width:600px; padding:30px;">
            <h2 style="margin-bottom:25px; color:#333;">Add Manual Adjustment</h2>
            <form id="addAdjustmentForm" style="display:flex; flex-direction:column; gap:15px;">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:15px;">
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Brand</label>
                        <select id="adjBrand" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                            <option value="">Select Brand</option>
                            {% for brand in brands %}
                            <option value="{{ brand.name }}">{{ brand.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Currency</label>
                        <select id="adjCurrency" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                            <option value="">Select Currency</option>
                            {% for currency in currencies %}
                            <option value="{{ currency.code }}">{{ currency.code }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:15px;">
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Gateway</label>
                        <select id="adjGateway" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                            <option value="">Select Gateway</option>
                        </select>
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Wallet</label>
                        <select id="adjWallet" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                            <option value="">Select Wallet</option>
                        </select>
                    </div>
                </div>
                <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:15px;">
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Shop</label>
                        <input type="text" id="adjShop" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Amount *</label>
                        <input type="number" id="adjAmount" step="0.01" required style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Fee</label>
                        <input type="number" id="adjFee" step="0.01" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                    </div>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:15px;">
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Type</label>
                        <select id="adjType" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                            <option value="">Select Type</option>
                            <option value="SPECIAL PAYMENT">SPECIAL PAYMENT</option>
                            <option value="SETTLEMENT">SETTLEMENT</option>
                            <option value="FUND TRANSFER IN">FUND TRANSFER IN</option>
                            <option value="FUND TRANSFER OUT">FUND TRANSFER OUT</option>
                            <option value="FEE">FEE</option>
                            <option value="ADJUSTMENT IN">ADJUSTMENT IN</option>
                            <option value="ADJUSTMENT OUT">ADJUSTMENT OUT</option>
                            <option value="SECURITY DEPOSIT">SECURITY DEPOSIT</option>
                            <option value="COMMISSION">COMMISSION</option>
                        </select>
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Gateway Date</label>
                        <input type="date" id="adjGatewayDate" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                    </div>
                </div>
                <div>
                    <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Remarks</label>
                    <textarea id="adjRemarks" rows="3" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px; resize:vertical;"></textarea>
                </div>
                <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:10px;">
                    <button type="button" onclick="closeAdjustmentModal()" style="background:#6c757d; color:white; padding:10px 20px; border:none; border-radius:4px; cursor:pointer;">Cancel</button>
                    <button type="submit" style="background:linear-gradient(135deg, #28a745 0%, #20c997 100%); color:white; padding:10px 20px; border:none; border-radius:4px; cursor:pointer; font-weight:600;">Add Adjustment</button>
                </div>
            </form>
        </div>
    </div>

    <!-- SIDEBAR -->
    <div class="sidebar collapsed" id="sidebar">
        <div class="sidebar-logo">
            <button class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar" aria-label="Toggle Sidebar" type="button">
                <img src="{{ url_for('static', filename='statistics_7208344.png') }}" alt="RECONTRIX">
            </button>
            <div class="sidebar-title">
                <div class="sidebar-title-main">RECONTRIX</div>
                <div class="sidebar-title-sub">Report Reconciliation</div>
            </div>
        </div>
        
        <div class="sidebar-menu">
            <button type="button" class="active nav-btn" data-target="dashboard" onclick="directTabSwitch('dashboard'); return false;"><img src="{{ url_for('static', filename='icon/DASHBOARD.png') }}" alt=""><span>{{ t('dashboard', language) }}</span></button>
            <button type="button" class="nav-btn" data-target="report" onclick="directTabSwitch('report'); return false;"><img src="{{ url_for('static', filename='icon/CHART.png') }}" alt=""><span>{{ t('monthly_report', language) }}</span></button>
            <button type="button" class="nav-btn" data-target="download" onclick="directTabSwitch('download'); return false;"><img src="{{ url_for('static', filename='icon/SHOP.png') }}" alt=""><span>SHOP BALANCE</span></button>
            <button type="button" class="nav-btn" data-target="deposit" onclick="directTabSwitch('deposit'); return false;"><img src="{{ url_for('static', filename='icon/DEPOSIT.png') }}" alt=""><span>{{ t('deposit', language) }}</span></button>
            <button type="button" class="nav-btn" data-target="withdrawal" onclick="directTabSwitch('withdrawal'); return false;"><img src="{{ url_for('static', filename='icon/WITHDRAWAL.png') }}" alt=""><span>{{ t('withdrawal', language) }}</span></button>
            <button type="button" class="nav-btn" data-target="adjustment" onclick="directTabSwitch('adjustment'); return false;"><img src="{{ url_for('static', filename='icon/ADJUSTMENT.png') }}" alt=""><span>{{ t('adjustment', language) }}</span></button>
            <button type="button" class="nav-btn" data-target="import" onclick="directTabSwitch('import'); return false;"><img src="{{ url_for('static', filename='icon/UPLOAD.png') }}" alt=""><span>{{ t('import_files', language) }}</span></button>
            {% if user_level == 'Admin' %}
            <button type="button" class="nav-btn" data-target="admin" onclick="directTabSwitch('admin'); return false;"><img src="{{ url_for('static', filename='icon/USER.png') }}" alt=""><span>{{ t('administrator', language) }}</span></button>
            {% endif %}
        </div>
    </div>
    
    <!-- MAIN CONTENT -->
    <div class="main-content collapsed" id="mainContent">
        <!-- HEADER -->
        <div class="header-section">
            <div class="user-section" data-current-username="{{ username }}">
                <div class="user-info">
                    <div><strong style="cursor: pointer; transition: color 0.2s; color: #1f2f3d;" onmouseover="this.style.color='#0056b3'" onmouseout="this.style.color='#1f2f3d'" onclick="openCurrentUserSettings()" title="Click to change username/password">{{ username }}</strong></div>
                    <div>{{ 'Administrator' if user_level == 'Admin' else 'Operation' }}</div>
                </div>
                <a href="{{ url_for('logout') }}" class="logout-btn" title="{{ t('logout', language) }}"><img src="{{ url_for('static', filename='icon/EXIT.png') }}" alt="Logout"></a>
            </div>
        </div>
        
        <!-- ALERTS -->
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                    <div class="alert alert-{{ category }}">{{ message }}</div>
                {% endfor %}
            {% endif %}
        {% endwith %}
        
        <!-- DASHBOARD SECTION -->
        <div class="section active" data-section="dashboard">
        <h2 style="color:#001a3d; font-size:20px; font-weight:600; letter-spacing:0.5px; text-align:left; margin-bottom:20px; text-transform:uppercase;">{{ t('dashboard', language) }}</h2>
        <div class="filters" data-section="dashboard" style="margin-bottom:30px;">
                <div class="filter-group date-filter">
                    <button type="button" class="date-icon" onclick="openDatePicker(this)"></button>
                    <input type="date" id="dashboardDateFrom">
                </div>
                <span class="to-separator">{{ t('to', language) or 'to' }}</span>
                <div class="filter-group date-filter">
                    <button type="button" class="date-icon" onclick="openDatePicker(this)"></button>
                    <input type="date" id="dashboardDateTo">
                </div>
                <div class="filter-group">
                    <select id="dashboardBrandSelect">
                        <option value="">All Brand</option>
                        {% for brand in brands %}
                        <option value="{{ brand.name }}">{{ brand.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="filter-group">
                    <select id="dashboardCurrencySelect">
                        {% for currency in currencies %}
                        <option value="{{ currency.code }}">{{ currency.code }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="filter-group">
                    <select id="dashboardGatewaySelect">
                        <option value="">All Gateways</option>
                        {% for currency in currencies %}
                            {% if gateways and gateways.get(currency.code) %}
                                {% for gateway in gateways[currency.code] %}
                                <option value="{{ gateway.name }}" data-currency="{{ currency.code }}">{{ gateway.name }}</option>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
                <button type="button" style="background: linear-gradient(135deg, #ff9500 0%, #ffa500 100%); border:none; padding:10px 12px; border-radius:4px; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; transition: all 0.3s ease;" title="{{ t('search', language) }}" onmouseover="this.style.background='linear-gradient(135deg, #ff8c00 0%, #ff9500 100%)'" onmouseout="this.style.background='linear-gradient(135deg, #ff9500 0%, #ffa500 100%)'" onclick="refreshDashboard();"><img src="{{ url_for('static', filename='icon/search.png') }}" alt="Search" style="width:18px; height:18px; filter:brightness(0) invert(1);"></button>
            </div>
        <!-- KPI CARDS -->
        <div class="kpi-container">
            <div class="kpi-card deposit">
                <div class="kpi-label">{{ t('total_deposit', language) }}</div>
                <div class="kpi-value" id="kpiDepositValue">0</div>
                <div class="kpi-note">Count: <span id="kpiDepositCount" style="font-weight:600;">0</span></div>
            </div>
            <div class="kpi-card withdrawal">
                <div class="kpi-label">{{ t('total_withdrawal', language) }}</div>
                <div class="kpi-value" id="kpiWithdrawalValue">0</div>
                <div class="kpi-note">Count: <span id="kpiWithdrawalCount" style="font-weight:600;">0</span></div>
            </div>
            <div class="kpi-card balance">
                <div class="kpi-label">{{ t('total_running_balance', language) }}</div>
                <div class="kpi-value" id="kpiBalanceValue">0</div>
            </div>
            <div class="kpi-card security">
                <div class="kpi-label">{{ t('total_security_deposit', language) }}</div>
                <div class="kpi-value" id="kpiSecurityValue">0</div>
            </div>
        </div>
        
        <!-- CHARTS -->
        <div class="charts-container three-charts">
            <div class="chart-card full-height">
                <div class="chart-title" id="transactionAnalysisTitle">Transaction Analysis</div>
                <div class="chart-canvas" style="height:220px; margin-bottom:18px;">
                    <canvas id="transactionAnalysisChart"></canvas>
                </div>
