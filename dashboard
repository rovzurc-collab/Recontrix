            function filterWalletsByType(currencySelectId, walletSelectId) {
                const currencySelect = document.getElementById(currencySelectId);
                const walletSelect = document.getElementById(walletSelectId);
                
                if (!currencySelect || !walletSelect) {
                    console.warn(`Wallet filter not found: ${currencySelectId}, ${walletSelectId}`);
                    return;
                }
                
                console.log(`Setting up wallet filter: ${currencySelectId} -> ${walletSelectId}`);
                
                // Store all original wallet options
                const allWalletOptions = Array.from(walletSelect.options).map(opt => ({
                    value: opt.value,
                    text: opt.textContent,
                    currency: opt.getAttribute('data-currency')
                }));
                
                console.log(`Stored wallet options:`, allWalletOptions);
                
                const filterWallets = () => {
                    const selectedCurrency = currencySelect.value;
                    console.log(`Currency selected for wallets: ${selectedCurrency}`);
                    
                    // Clear current options except the first one (All Wallets)
                    while (walletSelect.options.length > 1) {
                        walletSelect.remove(1);
                    }
                    
                    // Add filtered options
                    let addedCount = 0;
                    allWalletOptions.forEach(optData => {
                        if (optData.value === '') return; // Skip "All Wallets" option
                        
                        if (selectedCurrency === '' || optData.currency === selectedCurrency) {
                            const newOption = document.createElement('option');
