                    window.walletChart = new Chart(walletCtx, {
                        type: 'bar',
                        data: { 
                            labels: [], 
                            datasets: [{ 
                                label: `Wallet Balance (${currency})`, 
                                data: [], 
                                backgroundColor: [], 
                                borderColor: '#ffa500', 
                                borderWidth: 2 
                            }] 
                        },
                        options: { 
                            responsive: true, 
                            maintainAspectRatio: false, 
                            plugins: { legend: { display: false } }, 
                            scales: { 
                                y: { beginAtZero: true, ticks: { color: '#000' }, grid: { color: 'rgba(173, 216, 230, 0.6)' } }, 
                                x: { ticks: { color: '#000', autoSkip: false, maxRotation: 0, minRotation: 0, font: { size: 12, weight: '600' } }, grid: { color: 'rgba(173, 216, 230, 0.6)' } } 
                            } 
                        }
                    });
                }
                console.log('=== updateWalletChart END (empty) ===');
                return;
            }
            
            // � CALCULATE WALLET BALANCES FROM TRANSACTIONS (respects dashboard filters)
            console.log('💼 Calculating wallet balances from transaction data...');
            
            const fromValue = document.getElementById('dashboardDateFrom')?.value || '';
            const toValue = document.getElementById('dashboardDateTo')?.value || '';
            const brandFilter = normalizeFilterValue(document.getElementById('dashboardBrandSelect')?.value || '');
            const gatewayFilter = normalizeFilterValue(document.getElementById('dashboardGatewaySelect')?.value || '');
            
            const fromDate = fromValue ? new Date(fromValue + 'T00:00:00') : null;
            const toDate = toValue ? new Date(toValue + 'T23:59:59') : null;
            
            const walletBalances = {};
            const inRange = (dateObj) => {
                if (!dateObj) return false;
                if (fromDate && dateObj < fromDate) return false;
                if (toDate && dateObj > toDate) return false;
                return true;
            };
            
            // Helper to check if date is before date range (for opening balance calculation)
            const isBeforeRange = (dateObj) => {
                if (!dateObj) return false;
                if (fromDate && dateObj < fromDate) return true;
                return false;
            };
            
            const txData = window.originalTransactionData || {};
            
            // Step 1: Calculate OPENING WALLET BALANCES (all transactions BEFORE fromDate with filters)
            console.log('💼 Step 1: Calculating opening wallet balances...');
            currencyWallets.forEach(w => {
                walletBalances[normalizeFilterValue(w.name)] = 0;
            });
            
            // Opening deposits (before date range)
            (txData.deposit || []).forEach(tx => {
                if (tx.source_file === 'BACKOFFICE') return;
                if (normalizeFilterValue(tx.currency || '') !== normalizeFilterValue(currency)) return;
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;
                
                const dateObj = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                if (!isBeforeRange(dateObj)) return;  // Only opening period
                
                const wallet = normalizeFilterValue(tx.wallet || '');
                if (walletBalances.hasOwnProperty(wallet)) {
                    walletBalances[wallet] += parseFloat(tx.amount || 0);
                    walletBalances[wallet] -= parseFloat(tx.fee || 0);
                }
            });
            
            // Opening withdrawals (before date range)
            (txData.withdrawal || []).forEach(tx => {
                if (tx.source_file === 'BACKOFFICE') return;
                if (normalizeFilterValue(tx.currency || '') !== normalizeFilterValue(currency)) return;
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;
                
                const dateObj = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                if (!isBeforeRange(dateObj)) return;  // Only opening period
                
                const wallet = normalizeFilterValue(tx.wallet || '');
                if (walletBalances.hasOwnProperty(wallet)) {
                    walletBalances[wallet] -= parseFloat(tx.amount || 0);
                    walletBalances[wallet] -= parseFloat(tx.fee || 0);
                }
            });
            
            // Opening adjustments (before date range)
            (txData.adjustment || []).forEach(tx => {
                if (normalizeFilterValue(tx.currency || '') !== normalizeFilterValue(currency)) return;
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;
                
                const dateObj = parseTxnDate(tx.gateway_date || '');
                if (!isBeforeRange(dateObj)) return;  // Only opening period
                
                const wallet = normalizeFilterValue(tx.wallet || '');
                if (!walletBalances.hasOwnProperty(wallet)) return;
                
                const adjType = normalizeFilterValue(tx.type || '');
                const amount = parseFloat(tx.amount || 0);
                
                if (adjType.includes('fund transfer in') || adjType.includes('adjustment in')) {
                    walletBalances[wallet] += amount;
                } else if (adjType.includes('fund transfer out') || adjType.includes('adjustment out') || 
                          adjType.includes('special payment') || adjType.includes('settlement') || 
                          adjType.includes('fee') || adjType.includes('commission')) {
                    walletBalances[wallet] -= amount;
                }
            });
            
            console.log('💼 Step 1 complete - Opening balances:', walletBalances);
            
            // Step 2: Add CHANGES WITHIN DATE RANGE (from opening + period changes)
            console.log('💼 Step 2: Adding period changes...');
            
            // Period deposits (within date range)
            (txData.deposit || []).forEach(tx => {
                if (tx.source_file === 'BACKOFFICE') return;
                if (normalizeFilterValue(tx.currency || '') !== normalizeFilterValue(currency)) return;
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;
                
                const dateObj = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                if (!inRange(dateObj)) return;  // Only period transactions
                
                const wallet = normalizeFilterValue(tx.wallet || '');
                if (walletBalances.hasOwnProperty(wallet)) {
                    walletBalances[wallet] += parseFloat(tx.amount || 0);
                    walletBalances[wallet] -= parseFloat(tx.fee || 0);
                }
            });
            
            // Period withdrawals (within date range)
            (txData.withdrawal || []).forEach(tx => {
                if (tx.source_file === 'BACKOFFICE') return;
                if (normalizeFilterValue(tx.currency || '') !== normalizeFilterValue(currency)) return;
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;
                
                const dateObj = parseTxnDate(tx.gateway_date || tx.backoffice_date || '');
                if (!inRange(dateObj)) return;  // Only period transactions
                
                const wallet = normalizeFilterValue(tx.wallet || '');
                if (walletBalances.hasOwnProperty(wallet)) {
                    walletBalances[wallet] -= parseFloat(tx.amount || 0);
                    walletBalances[wallet] -= parseFloat(tx.fee || 0);
                }
            });
            
            // Period adjustments (within date range)
            (txData.adjustment || []).forEach(tx => {
                if (normalizeFilterValue(tx.currency || '') !== normalizeFilterValue(currency)) return;
                if (brandFilter && normalizeFilterValue(tx.brand) !== brandFilter) return;
                if (gatewayFilter && normalizeFilterValue(tx.gateway) !== gatewayFilter) return;
                
                const dateObj = parseTxnDate(tx.gateway_date || '');
                if (!inRange(dateObj)) return;  // Only period transactions
                
                const wallet = normalizeFilterValue(tx.wallet || '');
                if (!walletBalances.hasOwnProperty(wallet)) return;
                
                const adjType = normalizeFilterValue(tx.type || '');
                const amount = parseFloat(tx.amount || 0);
                
                if (adjType.includes('fund transfer in') || adjType.includes('adjustment in')) {
                    walletBalances[wallet] += amount;
                } else if (adjType.includes('fund transfer out') || adjType.includes('adjustment out') || 
                          adjType.includes('special payment') || adjType.includes('settlement') || 
                          adjType.includes('fee') || adjType.includes('commission')) {
                    walletBalances[wallet] -= amount;
                }
            });
            
            console.log('💼 Step 2 complete - Final wallet balances:', walletBalances);
            
            const walletDisplayRows = currencyWallets.map(w => {
                const balance = walletBalances[normalizeFilterValue(w.name)] || 0;
                return {
                    name: w.name,
                    balance
                };
            }).filter(item => Math.abs(item.balance) >= 0.1);

            const labels = walletDisplayRows.map(item => item.name);
            const values = walletDisplayRows.map(item => item.balance);
            
            console.log('Chart labels:', labels);
            console.log('Wallet balances:', walletBalances);
            console.log('Chart values:', values);
            
            // Rebuild wallet table rows for the selected currency (hide near-zero balances)
            const walletTableBody = document.getElementById('walletTableBody');
            if (walletTableBody) {
                walletTableBody.innerHTML = '';
                walletDisplayRows.forEach(wallet => {
                    const row = document.createElement('tr');
                    row.className = 'wallet-row';
                    row.setAttribute('data-currency', currency);
                    row.setAttribute('data-wallet', wallet.name);
                    row.style.backgroundColor = '#e6f2ff';
                    row.innerHTML = `
                        <td>${wallet.name}</td>
                        <td class="wallet-balance">0</td>
                    `;
                    walletTableBody.appendChild(row);
                });
            }

            // Update wallet table with calculated balances
            const walletRows = document.querySelectorAll('.wallet-row');
            let totalBalance = 0;
            walletRows.forEach(row => {
                const walletName = row.getAttribute('data-wallet');
                const normalizedWalletName = normalizeFilterValue(walletName);
                const balance = walletBalances[normalizedWalletName] || 0;
                totalBalance += balance;
                
                const balanceCell = row.querySelector('.wallet-balance');
                if (balanceCell) {
                    const formatted = Math.abs(balance).toLocaleString('en-US', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
                    balanceCell.textContent = balance < 0 ? `(${formatted})` : formatted;
                    balanceCell.style.color = balance < 0 ? '#c0392b' : '#000000';
                }
            });
            
            // Update table total
            const tableBalanceCell = document.querySelector('#walletTableFooter .table-balance');
            if (tableBalanceCell) {
                const formatted = Math.abs(totalBalance).toLocaleString('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
                tableBalanceCell.innerHTML = `<strong style="color:${totalBalance < 0 ? '#c0392b' : '#0b2d6b'};">${totalBalance < 0 ? '(' + formatted + ')' : formatted}</strong>`;
            }
            
            console.log('Updated wallet table with balances, total:', totalBalance.toFixed(2));
            
            // Update existing chart data instead of recreating
            if (window.walletChart && typeof window.walletChart.update === 'function' && window.walletChart.data) {
                console.log(`Updating wallet chart for ${currency} with ${labels.length} wallets:`, labels.join(', '));
                
                // Update labels and data
                window.walletChart.data.labels = labels;
                window.walletChart.data.datasets[0].label = `Wallet Balance (${currency})`;
                window.walletChart.data.datasets[0].data = values;
                window.walletChart.data.datasets[0].backgroundColor = labels.map((_, i) => 
                    `rgba(255, 165, 0, ${0.6 + (i % 3) * 0.1})`
                );
                
                // Force update
                window.walletChart.update();
                console.log('Wallet chart updated successfully');
            } else {
                console.log('ERROR: walletChart.data not available, trying to recreate...');
                
                // Fallback: recreate if chart is broken
                if (window.walletChart && typeof window.walletChart.destroy === 'function') {
                    try {
                        window.walletChart.destroy();
                    } catch(e) {
                        console.log('Error destroying broken chart:', e);
                    }
                }
                
                const chartContainer = document.getElementById('walletChart');
                if (chartContainer) {
                    // Clear and recreate canvas
                    const parent = chartContainer.parentNode;
                    const newCanvas = document.createElement('canvas');
                    newCanvas.id = 'walletChart';
                    newCanvas.style.maxHeight = '400px';
                    parent.removeChild(chartContainer);
                    parent.appendChild(newCanvas);
                    
                    console.log(`Creating NEW wallet chart for ${currency} with ${labels.length} wallets:`, labels.join(', '));
                    window.walletChart = new Chart(newCanvas, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: `Wallet Balance (${currency})`,
                            data: values,
                            backgroundColor: labels.map((_, i) => 
                                `rgba(255, 165, 0, ${0.6 + (i % 3) * 0.1})`
                            ),
                            borderColor: '#ffa500',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { color: '#000' },
                                grid: { color: 'rgba(173, 216, 230, 0.6)' }
                            },
                            x: {
                                ticks: {
                                    color: '#000',
                                    autoSkip: false,
                                    maxRotation: 0,
                                    minRotation: 0,
                                    font: {
                                        size: 12,
                                        weight: '600'
                                    }
                                },
                                grid: { color: 'rgba(173, 216, 230, 0.6)' }
                            }
                        }
                    }
                });
                console.log('New wallet chart created successfully');
                } else {
                    console.log('ERROR: walletChart canvas element not found!');
                }
            }
            console.log('=== updateWalletChart END ===');
        }
        
        /* Update Analysis Table with Wallet Balances */
        function updateAnalysisChart() {
            const gatewayElem = document.getElementById('dashboardGatewaySelect');
            const currencyElem = document.getElementById('dashboardCurrencySelect');
            const gateway = (gatewayElem && gatewayElem.value) || '';
            const currency = (currencyElem && currencyElem.value) || 'BDT';
            
            // Update gateway chart based on selected gateway filter
            updateGatewayChart(currency, gateway);

            // Update 7-day transaction analysis chart
            updateTransactionAnalysisChart(currency, gateway);
            
            // Update wallet chart and table based on selected gateway filter
            updateWalletChart(currency, gateway);
        }
        
        /* Auto-Logout on Inactivity (1 hour) */
        let inactivityTimer;
        const INACTIVITY_TIMEOUT = 60 * 60 * 1000; // 1 hour in milliseconds
        
        function resetInactivityTimer() {
            // Clear existing timer
            if (inactivityTimer) {
                clearTimeout(inactivityTimer);
            }
            
            // Set new timer - logout after 1 hour of inactivity
            inactivityTimer = setTimeout(() => {
                // Logout user
                fetch('/logout', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'}
                }).then(() => {
                    alert('Your session has expired due to inactivity. You have been logged out.');
                    window.location.href = '/login';
                }).catch(() => {
                    // Fallback: redirect to login if fetch fails
                    window.location.href = '/login';
                });
            }, INACTIVITY_TIMEOUT);
        }
        
        // Track user activity events
        const activityEvents = ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click'];
        
        activityEvents.forEach(event => {
            document.addEventListener(event, () => {
                resetInactivityTimer();
            }, true); // Use capture phase to catch events
        });
        
        // Initialize timer on page load
        resetInactivityTimer();
        
        /* Sidebar Toggle */
        const sidebarToggleBtn = document.getElementById('sidebarToggle');
        if (sidebarToggleBtn) {
            sidebarToggleBtn.addEventListener('click', function() {
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.getElementById('mainContent');
                
                if (sidebar) {
                    sidebar.classList.toggle('collapsed');
                }
                if (mainContent) {
                    mainContent.classList.toggle('collapsed');
                }
                scheduleChartResize();
            });
        }
        
        /* Handle chart responsiveness on zoom and resize */
        let resizeTimeout;
        let lastZoom = window.devicePixelRatio || 1;
        
        // Function to resize all charts
        function resizeAllCharts() {
            // Resize all chart instances
            const chartsToResize = [
                { name: 'analysisChartInstance', instance: analysisChartInstance },
                { name: 'gatewayChart', instance: window.gatewayChart },
                { name: 'walletChart', instance: window.walletChart },
                { name: 'barChartInstance', instance: window.barChartInstance },
                { name: 'barChartAltInstance', instance: window.barChartAltInstance },
                { name: 'pieChartInstance', instance: window.pieChartInstance },
                { name: 'pieChartAltInstance', instance: window.pieChartAltInstance }
            ];
            
            chartsToResize.forEach(chart => {
                if (chart.instance && typeof chart.instance.update === 'function') {
                    try {
                        // Force a redraw/update to apply the new dimensions
                        chart.instance.update('none');
                        console.log(`${chart.name} updated`);
                    } catch (e) {
                        console.error(`Error updating ${chart.name}:`, e);
                    }
                }
            });
        }

        function scheduleChartResize(delay = 80) {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                requestAnimationFrame(() => resizeAllCharts());
            }, delay);
        }
        
        // Resize handler
        window.addEventListener('resize', () => {
            scheduleChartResize(100);
        });
        
        // Handle browser zoom changes with multiple methods
        window.addEventListener('wheel', (e) => {
            if (e.ctrlKey || e.metaKey) {
                scheduleChartResize(50);
            }
        }, { passive: true });
        
        // Handle keyboard zoom (Ctrl/Cmd +/-)
        window.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && (e.key === '+' || e.key === '-' || e.key === '0')) {
                scheduleChartResize(50);
            }
        });

        if (window.visualViewport) {
            window.visualViewport.addEventListener('resize', () => scheduleChartResize(50));
            window.visualViewport.addEventListener('scroll', () => scheduleChartResize(50));
        }

        if (window.ResizeObserver) {
            const observer = new ResizeObserver(() => scheduleChartResize(60));
            document.querySelectorAll('.chart-canvas, .chart-card').forEach(el => observer.observe(el));
        }
        
        // Monitor zoom level changes continuously (most reliable method)
        setInterval(() => {
            const currentZoom = window.devicePixelRatio || 1;
            if (Math.abs(currentZoom - lastZoom) > 0.005) {
                lastZoom = currentZoom;
                scheduleChartResize(0);
            }
        }, 50);

    </script>
    
    <!-- EDIT USER MODAL -->
    <div id="editModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; justify-content:center; align-items:center;">
        <div style="background:white; padding:30px; border-radius:12px; box-shadow:0 10px 40px rgba(0,0,0,0.3); max-width:400px; width:90%;">
            <h2 style="margin-bottom:20px; color:#333;">{{ t('edit_user', language) }}</h2>
            <form method="POST" id="editForm">
                <div style="margin-bottom:15px;">
                    <label style="display:block; font-weight:600; margin-bottom:5px;">{{ t('username_label', language) }}</label>
                    <input type="text" id="editUsername" name="new_username" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px;">
                </div>
                <div style="margin-bottom:15px;">
                    <label style="display:block; font-weight:600; margin-bottom:5px;">{{ t('password_label', language) }}</label>
                    <input type="text" id="editPassword" name="new_password" placeholder="{{ t('leave_blank', language) }}" style="width:100%; padding:10px; border:1px solid #ddd; border-radius:6px;">
                </div>
                <div id="editPermissionsSection" style="margin-bottom:15px;">
                <div style="margin-bottom:15px;">
                    <label style="display:block; font-weight:600; margin-bottom:5px;">Allowed Brands (Operation only)</label>
                    <div id="editAllowedBrands" style="max-height:140px; overflow:auto; border:1px solid #ddd; border-radius:6px; padding:8px;">
                        {% for brand in brands %}
                        <label style="display:flex; align-items:center; gap:8px; font-size:12px; padding:4px 2px;">
                            <input type="checkbox" name="allowed_brands[]" value="{{ brand.name }}">
                            <span>{{ brand.name }}</span>
                        </label>
                        {% endfor %}
                    </div>
                    <div style="font-size:11px; color:#777; margin-top:4px;">Leave all unchecked to allow all brands.</div>
                </div>
                <div style="margin-bottom:15px;">
                    <label style="display:block; font-weight:600; margin-bottom:5px;">Allowed Currencies (Operation only)</label>
                    <div id="editAllowedCurrencies" style="max-height:140px; overflow:auto; border:1px solid #ddd; border-radius:6px; padding:8px;">
                        {% for currency in currencies %}
                        <label style="display:flex; align-items:center; gap:8px; font-size:12px; padding:4px 2px;">
                            <input type="checkbox" name="allowed_currencies[]" value="{{ currency.code }}">
                            <span>{{ currency.code }}</span>
                        </label>
                        {% endfor %}
                    </div>
                    <div style="font-size:11px; color:#777; margin-top:4px;">Leave all unchecked to allow all currencies.</div>
                </div>
                <div style="margin-bottom:15px;">
                    <label style="display:block; font-weight:600; margin-bottom:5px;">Allowed Gateways (Operation only)</label>
                    <div id="editAllowedGateways" style="max-height:180px; overflow:auto; border:1px solid #ddd; border-radius:6px; padding:8px;">
                        {% for currency in currencies %}
                            {% if gateways and gateways.get(currency.code) %}
                                <div style="font-weight:700; font-size:11px; color:#1b1b1b; margin:6px 0 2px;">{{ currency.code }}</div>
                                {% for gateway in gateways[currency.code] %}
                                <label style="display:flex; align-items:center; gap:8px; font-size:12px; padding:4px 2px;">
                                    <input type="checkbox" name="allowed_gateways[]" value="{{ currency.code }}::{{ gateway.name }}">
                                    <span>{{ gateway.name }}</span>
                                </label>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </div>
                    <div style="font-size:11px; color:#777; margin-top:4px;">Leave all unchecked to allow all gateways.</div>
                </div>
                </div>
                <input type="hidden" id="editAllowedBrandsInput" name="allowed_brands">
                <input type="hidden" id="editAllowedCurrenciesInput" name="allowed_currencies">
                <input type="hidden" id="editAllowedGatewaysInput" name="allowed_gateways">
                <div style="display:flex; gap:10px; margin-top:20px;">
                    <button type="submit" style="flex:1; padding:10px; background:#0066cc; color:white; border:none; border-radius:6px; cursor:pointer; font-weight:600;">{{ t('save', language) }}</button>
                    <button type="button" onclick="closeEditModal()" style="flex:1; padding:10px; background:#ccc; border:none; border-radius:6px; cursor:pointer;">{{ t('cancel', language) }}</button>
                </div>
            </form>
        </div>
    </div>
</body>
