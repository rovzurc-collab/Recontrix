        function formatDateForInput(dateStr) {
            if (!dateStr || dateStr === '-') return '';
            // Convert various formats like "01/01/2026" or "01/01/2026 18:53:29" to "2026-01-01"
            const datePart = dateStr.split(' ')[0];
            const parts = datePart.split('/');
            if (parts.length === 3) {
                // Try to detect if it's DD/MM/YYYY or MM/DD/YYYY
                // If first part > 12, it's definitely DD, if second part > 12, it's MM/DD format
                let day, month, year;
                if (parseInt(parts[0]) > 12) {
                    // It's DD/MM/YYYY
                    [day, month, year] = parts;
                } else if (parseInt(parts[1]) > 12) {
                    // It's MM/DD/YYYY
                    [month, day, year] = parts;
                } else {
                    // Ambiguous, assume MM/DD/YYYY (US format)
                    [month, day, year] = parts;
                }
                return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
            }
            return '';
        }
        
