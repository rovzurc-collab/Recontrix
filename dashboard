                const dateKey = normalizeGatewayDateKey(tx.gateway_date || tx.backoffice_date || '');
                if (!inRangeKey(dateKey)) return;
                const index = labelToIndex[dateKey];
                if (index === undefined) return;
                dailyDeposit[index] += Math.abs(parseTxnAmount(tx.amount));

                // Track per gateway
                const gatewayName = resolveGatewayName(tx);
                const gatewayKey = normalizeGatewayKey(gatewayName);
                if (gatewayKey) {
                    gatewaySet.add(gatewayKey);
                    if (!gatewayDisplayByKey[gatewayKey]) {
                        gatewayDisplayByKey[gatewayKey] = gatewayName;
                    }
                }
                if (!gatewayTotals[gatewayKey]) {
                    gatewayTotals[gatewayKey] = { deposit: 0, withdrawal: 0 };
                }
                gatewayTotals[gatewayKey].deposit += Math.abs(parseTxnAmount(tx.amount));

                if (gatewayKey) {
                    if (!perDateGatewayTotals.deposit[dateKey]) {
                        perDateGatewayTotals.deposit[dateKey] = {};
                    }
                    perDateGatewayTotals.deposit[dateKey][gatewayKey] =
                        (perDateGatewayTotals.deposit[dateKey][gatewayKey] || 0) + Math.abs(parseTxnAmount(tx.amount));
                }
            });

            (txData.withdrawal || []).forEach(tx => {
                if (!isGatewayTransaction(tx)) return;
                if (normalizedCurrency && normalizeFilterValue(tx.currency || '') !== normalizedCurrency) return;
                if (normalizedBrand && normalizeFilterValue(tx.brand || '') !== normalizedBrand) return;

                const dateKey = normalizeGatewayDateKey(tx.gateway_date || tx.backoffice_date || '');
                if (!inRangeKey(dateKey)) return;
                const index = labelToIndex[dateKey];
                if (index === undefined) return;
                dailyWithdrawal[index] += Math.abs(parseTxnAmount(tx.amount));

                // Track per gateway
