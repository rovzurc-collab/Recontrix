        function normalizeFilterValue(value) {
            return String(value || '').trim().toLowerCase();
        }

        function matchesText(haystack, needle) {
            if (!needle) return true;
            return normalizeFilterValue(haystack).includes(needle);
        }

        function matchesStatus(status, filterValue) {
            if (!filterValue) return true;
            const normalized = normalizeFilterValue(status);
            const normalizedFilter = filterValue.replace(/_/g, ' ');
            if (normalized.includes('wrong amount') && normalizedFilter.includes('wrong amount')) return true;
            if (normalized.includes('split amount') && normalizedFilter.includes('split amount')) return true;
            return normalized.replace(/\s+/g, '_') === filterValue;
        }

        function matchesDateRange(value, fromDate, toDate) {
            if (!fromDate && !toDate) return true;  // No date filter = include everything
            
            // If no value or it's empty/dash, don't filter it out
            if (!value || value === '-' || value.trim() === '') return true;
            
            // Normalize all dates to YYYY-MM-DD format for consistent comparison
            const normalizedValue = normalizeDateToISO(value);
            const normalizedFrom = fromDate ? normalizeDateToISO(fromDate) : null;
            const normalizedTo = toDate ? normalizeDateToISO(toDate) : null;
            
            // If we couldn't parse the transaction date, don't filter
            if (!normalizedValue) return true;
            
            // If only one boundary is set, use only that
            if (normalizedFrom && !normalizedTo) {
                return normalizedValue >= normalizedFrom;
            }
            if (normalizedTo && !normalizedFrom) {
                return normalizedValue <= normalizedTo;
            }
            
            // Both boundaries set - compare as ISO strings (YYYY-MM-DD)
            if (normalizedFrom && normalizedValue < normalizedFrom) return false;
            if (normalizedTo && normalizedValue > normalizedTo) return false;
            return true;
        }
        
        function normalizeDateToISO(dateStr) {
            if (!dateStr || dateStr === '-') return null;
            const text = String(dateStr).trim();
            if (!text) return null;
            
            // Already in ISO format (YYYY-MM-DD) - may have timestamp after
            if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
                return text.substring(0, 10);
            }
            
            // MM/DD/YYYY format (with or without time) - use regex without $ to allow timestamps
            if (/^\d{2}\/\d{2}\/\d{4}/.test(text)) {
                const parts = text.substring(0, 10).split('/');
                return `${parts[2]}-${parts[0]}-${parts[1]}`;
            }
            
            // DD/MM/YYYY format (common in some regions) - may have timestamp
            if (/^\d{1,2}\/\d{1,2}\/\d{4}/.test(text)) {
                const subset = text.split(' ')[0]; // Get just the date part if there's a timestamp
                const parts = subset.split('/');
                // Assume MM/DD/YYYY for now (this is what the app uses)
                return `${parts[2]}-${parts[0].padStart(2, '0')}-${parts[1].padStart(2, '0')}`;
            }
            
            // Try to parse with Date.parse and format it
            try {
                const parsed = new Date(text);
                if (!isNaN(parsed.getTime())) {
                    const year = parsed.getFullYear();
                    const month = String(parsed.getMonth() + 1).padStart(2, '0');
                    const day = String(parsed.getDate()).padStart(2, '0');
                    return `${year}-${month}-${day}`;
                }
            } catch (e) {
                /* ignore */
            }
            
            return null;
        }

        function formatGatewayName(value) {
            if (!value || value === '-') return '-';
            return String(value).replace(/[_-]+/g, ' ').trim();
        }

        function formatDateDisplay(value) {
            if (!value || value === '-') return '-';
            const text = String(value).trim();
            if (!text) return '-';

            // If already MM/DD/YYYY (with optional time), keep the date part
            if (/^\d{2}\/\d{2}\/\d{4}/.test(text)) {
                return text.slice(0, 10);
            }

            // If YYYY-MM-DD (with optional time), convert to MM/DD/YYYY
            if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
                const parts = text.slice(0, 10).split('-');
                return `${parts[1]}/${parts[2]}/${parts[0]}`;
            }

            // Fallback: try parsing and formatting
            const parsed = Date.parse(text);
            if (!Number.isNaN(parsed)) {
                const date = new Date(parsed);
                const mm = String(date.getMonth() + 1).padStart(2, '0');
                const dd = String(date.getDate()).padStart(2, '0');
                const yyyy = date.getFullYear();
                return `${mm}/${dd}/${yyyy}`;
            }

            return text;
        }

