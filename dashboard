        function resolveGatewayDisplayName(transaction) {
            const directGateway = String(transaction.gateway || '').trim();
            if (directGateway && directGateway !== '-') return directGateway;

            const sourceFile = String(transaction.source_file || '').trim();
            if (!sourceFile || sourceFile === 'BACKOFFICE') return '';

            // Handle NEW format: "{CURRENCY}_{GATEWAY_SLUG}" (e.g., "BDT_SMART_SOLUTION")
            if (!sourceFile.startsWith('PER_CURRENCY_')) {
                const parts = sourceFile.split('_');
                if (parts.length < 2) return '';
                // Convert underscore-separated gateway name to spaces
                // e.g., "BDT_SMART_SOLUTION" -> "SMART SOLUTION"
                return parts.slice(1).join(' ');
            }

            // Handle OLD format: "PER_CURRENCY_..." (legacy, keep for backward compatibility)
            const parts = sourceFile.split('_');
            if (parts.length <= 3) return '';
            return parts.slice(3).join(' ');
        }

