                        <img src="{{ url_for('static', filename='icon/DOWNLOAD.png') }}" alt="Export" style="width:36px; height:36px; display:block;">
                    </button>
                </div>
            </div>
            
            <div class="file-section">
                <div class="monthly-report-container">
                    <div id="monthlyReportLabel" style="margin-bottom:10px; font-size:12px; color:#0b5fa5; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; text-align:center;"></div>
                    <table id="monthlyReportTable" style="width:100%; border-collapse: collapse;">
                        <colgroup>
                            <col style="width:10%">
                            <col style="width:7%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:6%">
                            <col style="width:11%">
                        </colgroup>
                        <thead>
