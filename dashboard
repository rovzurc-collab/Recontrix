        // Helper function to chunk large arrays for batch processing
        function chunkArray(array, chunkSize) {
            const chunks = [];
            for (let i = 0; i < array.length; i += chunkSize) {
                chunks.push(array.slice(i, i + chunkSize));
            }
            return chunks;
        }
        
        async function batchDeleteTransactions(type) {
            // Determine if we're using "Select All" mode or just visible checkboxes
            const isSelectAllMode = selectAllState[type].active;
            const transactionsToDelete = [];
            
            if (isSelectAllMode) {
                // Use all transaction IDs from the select all state
                transactionsToDelete.push(...selectAllState[type].allIds);
            } else {
                // Use only checked rows visible on the page
                const rowCheckboxes = document.querySelectorAll(`.${type}RowCheckbox:checked`);
                
                for (const checkbox of rowCheckboxes) {
                    const row = checkbox.closest('tr');
                    const transactionId = row.dataset.transactionId;
                    const isCombined = row.dataset.combined === 'true';
                    const gatewayId = row.dataset.gatewayId;
                    const backofficeId = row.dataset.backofficeId;
                    const gatewayTableType = row.dataset.gatewayTableType || type;
                    const backofficeTableType = row.dataset.backofficeTableType || type;
                    
                    if (isCombined && gatewayId && backofficeId) {
                        transactionsToDelete.push({
                            id: transactionId,
                            isCombined: true,
                            gatewayId: gatewayId,
                            backofficeId: backofficeId,
                            gatewayTableType: gatewayTableType,
                            backofficeTableType: backofficeTableType
                        });
                    } else {
                        transactionsToDelete.push({
                            id: transactionId,
                            isCombined: false
                        });
                    }
                }
            }
            
            if (transactionsToDelete.length === 0) {
                alert('No transactions selected for deletion.');
                return;
            }
            
            const confirmMsg = `Are you sure you want to PERMANENTLY DELETE ${transactionsToDelete.length} ${type} transaction(s)?\n\nThis action is PERMANENT and cannot be undone.`;
            if (!confirm(confirmMsg)) {
                return;
            }
            
            showLoadingOverlay();
            
            // Separate combined and regular transactions for batch processing
            const regularTransactions = transactionsToDelete.filter(t => !t.isCombined);
            const combinedTransactions = transactionsToDelete.filter(t => t.isCombined);
            
            console.log(`📊 Delete breakdown: ${regularTransactions.length} regular, ${combinedTransactions.length} combined (matched)`);
            
            let successCount = 0;
            let failCount = 0;
            
            try {
                // Batch delete regular transactions in chunks (SQLite limit: 999 params)
                if (regularTransactions.length > 0) {
                    const regularIds = regularTransactions.map(t => t.id);
                    const chunks = chunkArray(regularIds, 500); // Safe chunk size
                    console.log(`🗑️ Batch deleting ${regularIds.length} regular ${type} transactions in ${chunks.length} chunk(s)...`);
                    
                    for (let i = 0; i < chunks.length; i++) {
                        const chunk = chunks[i];
                        console.log(`   Processing chunk ${i + 1}/${chunks.length} (${chunk.length} records)...`);
                        
                        try {
                            const response = await fetch('/api/batch_delete_transactions', {
                                method: 'POST',
                                headers: {'Content-Type': 'application/json'},
                                body: JSON.stringify({ids: chunk, type: type})
                            });
                            
                            const result = await response.json();
                            
                            if (result.success) {
                                successCount += result.deleted_count || chunk.length;
                                console.log(`   ✅ Chunk ${i + 1}: Deleted ${result.deleted_count} records`);
                            } else {
                                failCount += chunk.length;
                                console.error(`   ❌ Chunk ${i + 1} failed: ${result.message}`);
                                alert(`Error deleting chunk ${i + 1}: ${result.message}`);
                            }
                        } catch (chunkError) {
                            failCount += chunk.length;
                            console.error(`   ❌ Chunk ${i + 1} exception:`, chunkError);
                            alert(`Exception deleting chunk ${i + 1}: ${chunkError.message}`);
                        }
                    }
                }
                
                // Batch delete combined transactions (gateway and backoffice) in chunks
                if (combinedTransactions.length > 0) {
                    // Collect all gateway IDs and backoffice IDs
                    const gatewayIds = combinedTransactions.map(t => t.gatewayId);
                    const backofficeIds = combinedTransactions.map(t => t.backofficeId);
                    
                    console.log(`🗑️ Batch deleting ${combinedTransactions.length} combined ${type} transactions (gateway + backoffice)...`);
                    
                    // Delete gateway records in chunks
                    const gwChunks = chunkArray(gatewayIds, 500);
                    const gwTableType = ['deposit', 'withdrawal', 'adjustment'].includes((combinedTransactions[0].gatewayTableType || '').toLowerCase())
                        ? combinedTransactions[0].gatewayTableType.toLowerCase()
                        : type;
                    console.log(`   Deleting ${gatewayIds.length} gateway records in ${gwChunks.length} chunk(s)...`);
                    
                    let gwSuccess = 0;
                    let gwFail = 0;
                    for (let i = 0; i < gwChunks.length; i++) {
                        const chunk = gwChunks[i];
                        try {
                            const gwResult = await fetch('/api/batch_delete_transactions', {
                                method: 'POST',
                                headers: {'Content-Type': 'application/json'},
                                body: JSON.stringify({ids: chunk, type: gwTableType})
                            }).then(r => r.json());
                            
                            if (gwResult.success) {
                                gwSuccess += gwResult.deleted_count || chunk.length;
                                console.log(`   ✅ Gateway chunk ${i + 1}: Deleted ${gwResult.deleted_count}`);
                            } else {
                                gwFail += chunk.length;
                                console.error(`   ❌ Gateway chunk ${i + 1} failed: ${gwResult.message}`);
                            }
                        } catch (error) {
                            gwFail += chunk.length;
                            console.error(`   ❌ Gateway chunk ${i + 1} exception:`, error);
                        }
                    }
                    
                    // Delete backoffice records in chunks
                    const boChunks = chunkArray(backofficeIds, 500);
                    const boTableType = ['deposit', 'withdrawal', 'adjustment'].includes((combinedTransactions[0].backofficeTableType || '').toLowerCase())
                        ? combinedTransactions[0].backofficeTableType.toLowerCase()
                        : type;
                    console.log(`   Deleting ${backofficeIds.length} backoffice records in ${boChunks.length} chunk(s)...`);
                    
                    let boSuccess = 0;
                    let boFail = 0;
                    for (let i = 0; i < boChunks.length; i++) {
                        const chunk = boChunks[i];
                        try {
                            const boResult = await fetch('/api/batch_delete_transactions', {
                                method: 'POST',
                                headers: {'Content-Type': 'application/json'},
                                body: JSON.stringify({ids: chunk, type: boTableType})
                            }).then(r => r.json());
                            
                            if (boResult.success) {
                                boSuccess += boResult.deleted_count || chunk.length;
                                console.log(`   ✅ Backoffice chunk ${i + 1}: Deleted ${boResult.deleted_count}`);
                            } else {
                                boFail += chunk.length;
                                console.error(`   ❌ Backoffice chunk ${i + 1} failed: ${boResult.message}`);
                            }
                        } catch (error) {
                            boFail += chunk.length;
                            console.error(`   ❌ Backoffice chunk ${i + 1} exception:`, error);
                        }
                    }
                    
                    console.log(`📊 Combined results: Gateway=${gwSuccess} success/${gwFail} fail, Backoffice=${boSuccess} success/${boFail} fail`);
                    
                    if (gwSuccess > 0 && boSuccess > 0) {
                        const matchedPairs = Math.min(gwSuccess, boSuccess);
                        successCount += matchedPairs;
                        console.log(`✅ Successfully deleted ${matchedPairs} combined transaction pairs`);
                    }
                    
                    // Count failures
                    if (gwFail > 0 || boFail > 0) {
                        failCount += combinedTransactions.length;
                        console.error(`❌ Some combined transactions failed: ${gwFail} gateway failures, ${boFail} backoffice failures`);
                    }
                }
                
            } catch (error) {
                console.error('Batch delete error:', error);
                failCount = transactionsToDelete.length - successCount;
            }
            
            hideLoadingOverlay();
            
            // Reset select all state
            selectAllState[type].active = false;
            selectAllState[type].allIds = [];
            
            // Reset checkboxes
            const selectAllCheckbox = document.getElementById(`${type}SelectAll`);
            if (selectAllCheckbox) selectAllCheckbox.checked = false;
            updateBatchDeleteButton(type);
            
            // Reload data
            await loadTransactions(type);
            
            alert(`Batch delete complete:\n${successCount} transaction(s) deleted successfully.\n${failCount} transaction(s) failed.`);
        }
        
