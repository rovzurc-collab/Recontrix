        async function updateTransactionAnalysisChart(currency, selectedGateway = null) {
            const canvas = document.getElementById('transactionAnalysisChart');
            if (!canvas || typeof Chart === 'undefined') return;

            const normalizedCurrency = normalizeFilterValue(currency || document.getElementById('dashboardCurrencySelect')?.value || '');
            const normalizedBrand = normalizeFilterValue(document.getElementById('dashboardBrandSelect')?.value || '');
            const normalizedGateway = normalizeFilterValue(
                selectedGateway || document.getElementById('dashboardGatewaySelect')?.value || ''
            );
            const currencyValue = String(currency || document.getElementById('dashboardCurrencySelect')?.value || '').toUpperCase();

            const fromValue = document.getElementById('dashboardDateFrom')?.value || '';
            const toValue = document.getElementById('dashboardDateTo')?.value || '';

            let startDate = fromValue ? new Date(fromValue + 'T00:00:00') : null;
            let endDate = toValue ? new Date(toValue + 'T23:59:59') : null;

            if (!startDate || Number.isNaN(startDate.getTime()) || !endDate || Number.isNaN(endDate.getTime()) || startDate > endDate) {
                endDate = new Date();
                endDate.setHours(23, 59, 59, 999);
                startDate = new Date(endDate);
                startDate.setDate(endDate.getDate() - 6);
                startDate.setHours(0, 0, 0, 0);
            }

            const toLocalIsoDate = (dateObj) => {
                const year = dateObj.getFullYear();
                const month = String(dateObj.getMonth() + 1).padStart(2, '0');
                const day = String(dateObj.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            };

            const parseTxnAmount = (amountValue) => {
                if (typeof amountValue === 'number') return amountValue;
                const cleaned = String(amountValue || '').replace(/[^0-9.-]/g, '');
                const parsed = parseFloat(cleaned);
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const labels = buildDateLabels(
                toLocalIsoDate(startDate),
                toLocalIsoDate(endDate)
            );
            const dailyDeposit = Array(labels.length).fill(0);
            const dailyWithdrawal = Array(labels.length).fill(0);
            const labelToIndex = {};

            const fromKey = toLocalIsoDate(startDate);
            const toKey = toLocalIsoDate(endDate);

            const yearByIndex = [];
            const cursor = new Date(startDate);
            while (cursor <= endDate) {
                yearByIndex.push(cursor.getFullYear());
                cursor.setDate(cursor.getDate() + 1);
            }

            labels.forEach((label, index) => {
                const [mm, dd] = String(label).split('/');
                const key = `${yearByIndex[index]}-${String(mm).padStart(2, '0')}-${String(dd).padStart(2, '0')}`;
                labelToIndex[key] = index;
            });

            const normalizeGatewayDateKey = (value) => {
                if (!value) return '';
                if (value instanceof Date && !Number.isNaN(value.getTime())) {
                    const year = value.getFullYear();
                    const month = String(value.getMonth() + 1).padStart(2, '0');
                    const day = String(value.getDate()).padStart(2, '0');
                    return `${year}-${month}-${day}`;
                }

                const parsed = parseTxnDate(value);
                if (!parsed) return '';
                const year = parsed.getFullYear();
                const month = String(parsed.getMonth() + 1).padStart(2, '0');
                const day = String(parsed.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            };

            const inRangeKey = (dateKey) => {
                if (!dateKey) return false;
                if (fromKey && dateKey < fromKey) return false;
                if (toKey && dateKey > toKey) return false;
                return true;
            };
            const txData = window.originalTransactionData || {};

            // Collect gateway totals
            const gatewayTotals = {};
            const gatewaySet = new Set();
            const gatewayDisplayByKey = {};
            const perDateGatewayTotals = {
                deposit: {},
                withdrawal: {}
            };

            const normalizeGatewayKey = (value) => {
                const raw = String(value || '').trim();
                if (!raw || raw === '-') return '';
                return normalizeFilterValue(raw);
            };

            const resolveGatewayName = (tx) => {
                const directGateway = String(tx.gateway || '').trim();
                if (directGateway && directGateway !== '-') return directGateway;

                const sourceFile = String(tx.source_file || '').trim();
                if (!sourceFile) return '';
                if (!sourceFile.startsWith('PER_CURRENCY_')) return '';

                const parts = sourceFile.split('_');
                if (parts.length <= 3) return '';
                return parts.slice(3).join(' ');
            };

            const isGatewayTransaction = (tx) => {
                const sourceFile = String(tx.source_file || '').trim().toUpperCase();
                if (sourceFile === 'MERGED') return false;
                const status = String(tx.status || '').trim().toLowerCase();
                if (status === 'voided') return false;
                return true;
