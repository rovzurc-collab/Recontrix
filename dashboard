            const toDate = toValue ? new Date(toValue + 'T23:59:59') : null;

            const inRange = (dateObj) => {
                if (!dateObj) return false;
                if (fromDate && dateObj < fromDate) return false;
                if (toDate && dateObj > toDate) return false;
                return true;
            };

            const isBeforeRange = (dateObj) => {
                if (!dateObj) return false;
                return !!(fromDate && dateObj < fromDate);
            };

            const resolveGatewayName = (tx) => {
                const directGateway = String(tx.gateway || '').trim();
                if (directGateway && directGateway !== '-') {
                    return directGateway;
                }

                const sourceFile = String(tx.source_file || '').trim();
                if (!sourceFile || sourceFile === 'BACKOFFICE') {
                    return '';
                }

                if (sourceFile.startsWith('PER_CURRENCY_')) {
                    return '';
                }

                // Format: replace underscores with spaces and uppercase
                return sourceFile.replace(/_/g, ' ').toUpperCase().trim();
            };

            const formatFileName = (name) => {
                if (!name) return '';
                return String(name).replace(/_/g, ' ').toUpperCase().trim();
            };

            const getRunningBalanceFromMonthlyReport = async () => {
                if (!fromDate || !toDate || !normalizedGatewayFilter) return null;

                let runningBalance = 0;
                let initialized = false;
                const monthCursor = new Date(fromDate.getFullYear(), fromDate.getMonth(), 1);
                const endMonth = new Date(toDate.getFullYear(), toDate.getMonth(), 1);

                while (monthCursor <= endMonth) {
                    const month = String(monthCursor.getMonth() + 1).padStart(2, '0');
                    const year = String(monthCursor.getFullYear());

                    const response = await fetch('/api/monthly_report', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            month,
                            year,
                            currency: normalizedCurrency ? normalizedCurrency.toUpperCase() : '',
                            brand: normalizedBrand ? normalizedBrand.toUpperCase() : '',
                            gateway: normalizedGatewayFilter.toUpperCase(),
                            wallet: '',
                            shop: ''
                        })
                    });

                    const result = await response.json();
                    if (!result.success || !Array.isArray(result.data)) {
                        monthCursor.setMonth(monthCursor.getMonth() + 1);
                        continue;
                    }

                    const openingRow = result.data.find(day => day.date === 'Opening Balance');
                    if (!initialized) {
                        runningBalance = Number(openingRow?.running_balance || 0);
                        initialized = true;
                    }

                    result.data.forEach(day => {
                        if (day.date === 'Opening Balance') return;
                        const dayDate = new Date(String(day.date) + 'T00:00:00');
                        if (Number.isNaN(dayDate.getTime())) return;
                        if (dayDate > toDate) return;

                        runningBalance = runningBalance +
                            Number(day.deposit_amount || 0) -
                            Number(day.withdrawal_amount || 0) +
                            Number(day.fund_transfer_in || 0) +
                            Number(day.fund_transfer_out || 0) +
                            Number(day.special_payment || 0) +
                            Number(day.settlement || 0) +
                            Number(day.fee || 0) +
                            Number(day.adjustment_in || 0) +
                            Number(day.adjustment_out || 0) +
                            Number(day.commission || 0);
                    });

                    monthCursor.setMonth(monthCursor.getMonth() + 1);
                }

                return initialized ? runningBalance : null;
            };

            const getRunningBalanceForGateway = async (gatewayName) => {
                if (!fromDate || !toDate || !gatewayName) return null;

                let runningBalance = 0;
                let initialized = false;
                const monthCursor = new Date(fromDate.getFullYear(), fromDate.getMonth(), 1);
                const endMonth = new Date(toDate.getFullYear(), toDate.getMonth(), 1);

                while (monthCursor <= endMonth) {
                    const month = String(monthCursor.getMonth() + 1).padStart(2, '0');
