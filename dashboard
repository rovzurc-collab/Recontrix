            canAccessCurrency: function(currencyCode) {
                if (this.isAdmin) return true;
                if (this.allowedCurrencies.length === 0) return true; // No restrictions = all allowed
                return this.allowedCurrencies.some(c => c.toUpperCase() === (currencyCode || '').toUpperCase());
