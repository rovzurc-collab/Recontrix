            const handleUploadSuccess = (fileType, fileName) => {
                refreshDropzone(fileType, fileName);
                enableDeleteButton(fileType);
                setStatus(fileType, 'Upload complete');
                
                // Update main import status to show files ready
                updateMainImportStatus();
                
                // Clear cache flags so next Search click fetches fresh data (no auto-reload)
                if (window.transactionDataLoaded) {
                    window.transactionDataLoaded.deposit = false;
                    window.transactionDataLoaded.withdrawal = false;
                    console.log('🔄 Cleared deposit/withdrawal cache flags after upload - click Search to view updated data');
                }
            };

            // Update main import status message to show how many files are uploaded
            const updateMainImportStatus = () => {
                const uploadedCount = document.querySelectorAll('.dropzone span[style*="font-weight:700"]').length;
                const importStatusEl = document.getElementById('importStatus');
                if (importStatusEl) {
                    if (uploadedCount === 0) {
                        importStatusEl.textContent = 'No files uploaded';
                        importStatusEl.style.color = '#c0392b';
                    } else if (uploadedCount === 1) {
                        importStatusEl.textContent = '1 file ready to import';
                        importStatusEl.style.color = '#2e8b57';
                    } else {
                        importStatusEl.textContent = `${uploadedCount} files ready to import`;
                        importStatusEl.style.color = '#2e8b57';
                    }
                }
            };

            const uploadViaS3 = async (fileType, file) => {
                console.log('[UPLOAD] uploadViaS3 called:', { fileType, file: file ? file.name : 'null' });
                if (inflightUploads[fileType]) {
                    console.warn('[UPLOAD] Upload already in progress for', fileType);
                    setStatus(fileType, 'Another upload is already in progress', true);
                    return;
                }
                inflightUploads[fileType] = true;
                const finish = () => { 
                    console.log('[UPLOAD] Cleaning up upload state for', fileType);
                    delete inflightUploads[fileType]; 
                };

                if (!file) {
                    console.log('[UPLOAD] No file provided');
                    finish();
                    return;
                }
                const ext = (file.name || '').toLowerCase().split('.').pop();
                const allowed = ['xlsx', 'xls', 'csv'];
                if (!allowed.includes(ext)) {
                    setStatus(fileType, 'Only .xlsx, .xls or .csv are allowed', true);
                    finish();
                    return;
                }

                try {
                    setStatus(fileType, 'Requesting upload URL…');
                    console.log('[UPLOAD] Calling upload_init endpoint');

                    const initRes = await fetch("{{ url_for('upload_init') }}", {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            file_type: fileType,
                            filename: file.name,
                            content_type: file.type || 'application/octet-stream'
                        })
                    }).then(async r => {
                        console.log('[UPLOAD] upload_init response status:', r.status);
                        const text = await r.text();
                        console.log('[UPLOAD] upload_init response text:', text.substring(0, 200));
                        try {
                            return JSON.parse(text);
                        } catch (e) {
                            console.error('[UPLOAD] Failed to parse upload_init response:', e);
                            return { success: false, message: 'Invalid response from upload_init: ' + e.message };
                        }
                    }).catch((err) => { 
                        console.error('[UPLOAD] fetch error:', err);
                        return { success: false, message: 'Network error: ' + err.message }; 
                    });

                    if (!initRes.success) {
                        setStatus(fileType, initRes.message || 'Upload init failed', true);
                        console.error('[UPLOAD] init failed:', initRes);
                        finish();
                        return;
                    }

                    // If use_local is true, fall back to local upload
                    if (initRes.use_local) {
                        console.log('[UPLOAD] S3 disabled, falling back to local upload');
                        await uploadLocal(fileType, file, finish);
                        return;
                    }

                    console.log('[UPLOAD] Using S3 upload with URL:', initRes.url ? initRes.url.substring(0, 50) + '...' : 'N/A');

                const formData = new FormData();
                Object.entries(initRes.fields || {}).forEach(([k, v]) => formData.append(k, v));
                formData.append('file', file);

                await new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    xhr.open('POST', initRes.url, true);

                    xhr.upload.onprogress = (e) => {
                        if (e.lengthComputable) {
                            const pct = Math.round((e.loaded / e.total) * 100);
                            setStatus(fileType, `Uploading… ${pct}%`);
                        }
                    };

                    xhr.onload = async () => {
                        if (xhr.status === 204 || xhr.status === 201) {
                            const finalize = await fetch("{{ url_for('upload_finalize') }}", {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    file_type: fileType,
                                    key: initRes.key,
                                    filename: file.name
                                })
                            }).then(async r => {
                                console.log('[UPLOAD] S3 finalize response status:', r.status);
                                if (!r.ok) {
                                    const text = await r.text();
                                    console.error('[UPLOAD] S3 finalize error response:', r.status, text);
                                    return { success: false, message: `HTTP ${r.status}: ${text}` };
                                }
                                try {
                                    return await r.json();
                                } catch (e) {
                                    console.error('[UPLOAD] Failed to parse S3 finalize response:', e);
                                    return { success: false, message: 'Invalid JSON from finalize' };
                                }
                            }).catch(err => {
                                console.error('[UPLOAD] S3 finalize fetch error:', err);
                                return { success: false, message: 'Network error: ' + err.message };
                            });

                            console.log('[UPLOAD] S3 finalize response:', finalize);
                            if (finalize && finalize.success) {
                                handleUploadSuccess(fileType, file.name);
                                resolve();
                            } else {
                                const errorMsg = finalize ? (finalize.message || 'Unknown finalize error') : 'No response from finalize';
                                setStatus(fileType, 'Finalize failed: ' + errorMsg, true);
                                reject();
                            }
                        } else {
                            console.error('[UPLOAD] S3 upload failed, xhr status:', xhr.status, 'statusText:', xhr.statusText);
                            setStatus(fileType, 'Upload failed (Status: ' + xhr.status + ')', true);
                            reject();
                        }
                    };

                    xhr.onerror = () => {
                        console.error('[UPLOAD] XHR error, status:', xhr.status, 'statusText:', xhr.statusText);
                        setStatus(fileType, 'Upload failed - Network error (Status: ' + xhr.status + ')', true);
                        reject();
                    };

                    xhr.send(formData);
                });
                } catch (error) {
                    console.error('[UPLOAD] Catch error:', error, 'Stack:', error.stack);
                    const errorMsg = error ? (error.message || error.toString()) : 'Unknown error';
                    console.log('[UPLOAD] Final error message:', errorMsg);
                    setStatus(fileType, 'Upload error: ' + errorMsg, true);
                } finally {
                    finish();
                }
            };

            const uploadLocal = async (fileType, file, finishCb) => {
                console.log('[UPLOAD_LOCAL] Starting local upload for:', fileType, 'file:', file.name);
                if (inflightUploads[fileType] && !finishCb) {
                    setStatus(fileType, 'Another upload is already in progress', true);
                    return;
                }
                if (!finishCb) inflightUploads[fileType] = true;
                const finish = () => {
                    if (finishCb) {
                        finishCb();
                    } else {
                        delete inflightUploads[fileType];
                    }
                };
                const formData = new FormData();
                formData.append('file_type', fileType);
                formData.append('file', file);

                try {
                    await new Promise((resolve, reject) => {
                        const xhr = new XMLHttpRequest();
                        xhr.open('POST', "{{ url_for('upload_file') }}", true);

                        xhr.upload.onprogress = (e) => {
                            if (e.lengthComputable) {
                                const pct = Math.round((e.loaded / e.total) * 100);
                                setStatus(fileType, `Uploading… ${pct}%`);
                            }
                        };

                        xhr.onload = () => {
                            console.log('[UPLOAD_LOCAL] XHR onload, status:', xhr.status, 'response:', xhr.responseText ? xhr.responseText.substring(0, 200) : 'empty');
                            let res = { success: false, message: 'Unknown response' };
                            try {
                                if (xhr.responseText && xhr.responseText.trim().length > 0) {
                                    res = JSON.parse(xhr.responseText);
                                } else {
                                    console.warn('[UPLOAD_LOCAL] Empty response from server');
                                }
                            } catch (parseErr) {
                                console.error('[UPLOAD_LOCAL] Failed to parse JSON response:', parseErr, 'raw:', xhr.responseText ? xhr.responseText.substring(0, 200) : 'empty');
                                res = { success: false, message: 'Invalid server response: ' + parseErr.message };
                            }
                            if (res.success) {
                                const finalRes = fetch("{{ url_for('upload_finalize') }}", {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        file_type: fileType,
                                        filename: file.name
                                    })
                                }).then(async r => {
                                    console.log('[UPLOAD_LOCAL] Finalize response status:', r.status);
                                    if (!r.ok) {
                                        const text = await r.text();
                                        console.error('[UPLOAD_LOCAL] Finalize error response:', r.status, text);
                                        return { success: false, message: `HTTP ${r.status}: ${text}` };
                                    }
                                    try {
                                        return await r.json();
                                    } catch (e) {
                                        console.error('[UPLOAD_LOCAL] Failed to parse finalize response:', e);
                                        return { success: false, message: 'Invalid JSON response from finalize' };
                                    }
                                }).catch(err => { 
                                    console.error('[UPLOAD_LOCAL] Finalize fetch error:', err);
                                    return { success: false, message: 'Network error: ' + err.message }; 
                                });

                                finalRes.then(finalResData => {
                                    console.log('[UPLOAD_LOCAL] Finalize response data:', finalResData);
                                    if (finalResData && finalResData.success) {
                                        console.log('[UPLOAD_LOCAL] Finalize successful');
                                        handleUploadSuccess(fileType, file.name);
                                        resolve();
                                    } else {
                                        const errorMsg = finalResData ? (finalResData.message || 'Unknown finalize error') : 'No response from finalize';
                                        console.error('[UPLOAD_LOCAL] Finalize failed:', errorMsg);
                                        setStatus(fileType, 'Upload finalize failed: ' + errorMsg, true);
                                        reject();
                                    }
                                });
                            } else {
                                console.error('[UPLOAD_LOCAL] Upload failed:', res);
                                setStatus(fileType, res.message || 'Upload failed', true);
                                reject();
                            }
                        };

                        xhr.onerror = () => {
                            console.error('[UPLOAD_LOCAL] XHR error, status:', xhr.status, 'statusText:', xhr.statusText, 'responseText:', xhr.responseText ? xhr.responseText.substring(0, 200) : 'empty');
                            setStatus(fileType, 'Network error during upload (Status: ' + xhr.status + ', ' + xhr.statusText + ')', true);
                            reject();
                        };

                        xhr.ontimeout = () => {
                            console.error('[UPLOAD_LOCAL] XHR timeout');
                            setStatus(fileType, 'Upload timeout - file too large or server slow', true);
                            reject();
                        };

                        xhr.send(formData);
                    });
                } catch (error) {
                    console.error('[UPLOAD_LOCAL] Error:', error);
                    const errorMsg = error ? (error.message || error.toString()) : 'Unknown error';
                    setStatus(fileType, 'Upload error: ' + errorMsg, true);
                } finally {
                    finish();
                }
            };

            // eslint-disable-next-line no-undef
            const dropzones = document.querySelectorAll('.dropzone');
            console.log('[UPLOAD] Found', dropzones.length, 'dropzones');
            if (dropzones.length === 0) {
                console.warn('[UPLOAD] WARNING: No dropzones found! Check if .section[data-section="import"] is visible');
            }
            dropzones.forEach(zone => {
                const fileType = zone.dataset.filetype;
                console.log('[UPLOAD] Setting up dropzone for:', fileType);

                const uploadFile = (file) => {
                    console.log('[UPLOAD] uploadFile called for', fileType, 'with file:', file ? file.name : 'null');
                    uploadViaS3(fileType, file);
                };

                // Make dropzone clickable
                zone.style.pointerEvents = 'auto';
                zone.style.cursor = 'pointer';

                zone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    zone.classList.add('dragover');
                });
                
                zone.addEventListener('dragleave', () => {
                    zone.classList.remove('dragover');
                });

                zone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    zone.classList.remove('dragover');
                    const file = e.dataTransfer.files[0];
                    if (file) {
                        console.log('[UPLOAD] File dropped:', file.name);
                        uploadFile(file);
                    }
                });

                zone.addEventListener('click', (e) => {
                    e.stopPropagation();
                    console.log('[UPLOAD] Dropzone click detected for:', fileType);
                    const picker = document.createElement('input');
                    picker.type = 'file';
                    picker.accept = '.xlsx,.xls,.csv';
                    picker.addEventListener('change', () => {
                        if (picker.files[0]) {
                            console.log('[UPLOAD] File selected:', picker.files[0].name);
                            uploadFile(picker.files[0]);
                        }
                    });
                    picker.click();
                });
            });
            
            // File browse buttons in upload table
            document.querySelectorAll('.file-browse-btn').forEach(btn => {
                btn.style.pointerEvents = 'auto';
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    const fileType = btn.dataset.filetype;
                    const fileInput = document.querySelector(`input.file-input[data-filetype="${fileType}"]`);
                    if (fileInput) {
                        fileInput.click();
                        console.log('[UPLOAD] File picker opened for:', fileType);
                    }
                });
            });
            
            // Delete file function
            window.deleteFile = function(fileType, el) {
                const deleteBtn = el || event?.currentTarget || event?.target?.closest('button');
                if (deleteBtn?.hasAttribute('disabled') || deleteBtn?.style.opacity === '0.4') {
                    setStatus(fileType, 'No file to delete', true);
                    return;
                }

                // Simple confirmation - only deleting the file upload, not the data
                if (!confirm('Delete this uploaded file?\n\nNote: This only removes the file upload record.\nYour imported transaction data will be preserved.')) {
                    return;
                }

                setStatus(fileType, 'Deleting file…');
                console.log(`🗑️ Deleting file: ${fileType}`);

                fetch("{{ url_for('delete_file') }}", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({file_type: fileType})
                }).then(response => response.json()).then(data => {
                    if (data.success) {
                        console.log(`✅ File deleted successfully: ${fileType}`);
                        
                        // Clear the dropzone UI
                        refreshDropzone(fileType, '');
                        
                        // Disable delete button
                        disableDeleteButton(fileType);
                        
                        // Update status message
                        setStatus(fileType, 'File removed (data preserved)');
                        
                        // Update main import status
                        updateMainImportStatus();
                        
                        // Clear the file input if it exists
                        const fileInput = document.querySelector(`input.file-input[data-filetype="${fileType}"]`);
                        if (fileInput) {
                            fileInput.value = '';
                        }
                        
                        console.log(`✅ UI updated for deleted file: ${fileType}`);
                    } else {
                        console.error(`❌ Delete failed: ${data.message}`);
                        setStatus(fileType, data.message || 'Delete failed', true);
                    }
                }).catch(err => {
                    console.error('❌ Delete error:', err);
                    setStatus(fileType, 'Delete failed: ' + err.message, true);
                });
            };
            
            // File input change handler
            document.querySelectorAll('input.file-input').forEach(input => {
                input.addEventListener('change', (e) => {
                    const file = e.target.files[0];
                    if (file) {
                        const fileType = input.dataset.filetype;
                        console.log('[UPLOAD] File input changed for:', fileType, '- File:', file.name);
                        uploadViaS3(fileType, file);
                    }
                    e.target.value = '';
                });
            });
            
            // Ensure import section sections are clickable
            const importSection = document.querySelector('.section[data-section="import"]');
            if (importSection) {
                importSection.style.pointerEvents = 'auto';
                console.log('✅ Import section set to clickable');
            }
            
            // Ensure all nav buttons are clickable
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.style.pointerEvents = 'auto';
                btn.style.cursor = 'pointer';
            });
            console.log('✅ All nav buttons set to clickable');
            
            // Ensure all sections are clickable
            document.querySelectorAll('.section').forEach(section => {
                section.style.pointerEvents = 'auto';
            });
            console.log('✅ All sections set to clickable');
            
            console.log('✅✅✅ UPLOAD AND NAVIGATION SYSTEM INITIALIZATION COMPLETE ✅✅✅');
        });

        // Define these functions BEFORE first script ends so they're available
        function initTableControls(type) {
            const state = getTableState(type);
            const entriesSelect = document.getElementById(`${type}EntriesSelect`);
            const prevBtn = document.getElementById(`${type}PrevPage`);
            const nextBtn = document.getElementById(`${type}NextPage`);
            const tableBody = document.getElementById(`${type}Table`);
            const table = tableBody ? tableBody.closest('table') : null;

            if (entriesSelect) {
                entriesSelect.value = String(state.pageSize);
                entriesSelect.addEventListener('change', () => {
                    const value = parseInt(entriesSelect.value, 10);
                    state.pageSize = Number.isNaN(value) ? 100 : value;
                    state.page = 1;
                    loadTransactions(type);
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    if (state.page > 1) {
                        state.page -= 1;
                        loadTransactions(type);
                    }
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    state.page += 1;
                    loadTransactions(type);
                });
            }

            if (table) {
                table.querySelectorAll('th.sortable').forEach(th => {
                    th.addEventListener('click', () => {
                        const sortKey = th.dataset.sortKey;
                        if (!sortKey) return;
                        if (state.sortKey === sortKey) {
                            state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
                        } else {
                            state.sortKey = sortKey;
                            state.sortDir = 'asc';
                        }
                        state.page = 1;
                        renderTransactions(type, transactionStore[type] || []);
                    });
                });
            }
        }

        async function loadTransactions(type, loadAll = false) {
            const endpoints = {
                deposit: '/api/deposits',
                withdrawal: '/api/withdrawals',
                adjustment: '/api/adjustments'
            };
            
            const endpoint = endpoints[type];
            if (!endpoint) {
                console.error(`Unknown transaction type: ${type}`);
                return;
            }
            
            try {
                console.log(`📥 Fetching ${type} transactions from ${endpoint}... (loadAll=${loadAll})`);
                const state = getTableState(type);
                const params = new URLSearchParams();
                params.set('_', new Date().getTime());
                if (type === 'deposit' || type === 'withdrawal') {
                    if (loadAll) {
                        params.set('page', '1');
                        params.set('page_size', '50000');
                    } else {
                        params.set('page', String(state.page));
                        params.set('page_size', String(state.pageSize));
                    }
                }
                const res = await fetch(`${endpoint}?${params.toString()}`);
                const result = await res.json();
                
                if (result.success && result.data) {
                    originalTransactionData[type] = Array.isArray(result.data) ? [...result.data] : [];
                    console.log(`📦 Stored ${originalTransactionData[type].length} original ${type} records`);
                    
                    if (originalTransactionData[type].length > 0) {
                        console.log(`📋 Sample data (first 3):`, originalTransactionData[type].slice(0, 3));
                    }
                    
                    if (type === 'deposit' || type === 'withdrawal') {
                        updateStatusBars();
                        updateKPIValues();
                    }
                    
                    if (type === 'deposit' || type === 'withdrawal') {
                        const serverTotal = Number(result.total_count);
                        state.totalCount = Number.isFinite(serverTotal)
                            ? serverTotal
                            : (Array.isArray(result.data) ? result.data.length : 0);
                    } else {
                        state.totalCount = Array.isArray(result.data) ? result.data.length : 0;
                    }

                    const filtered = applyFilters(type, originalTransactionData[type]);
                    console.log(`✅ Loaded ${result.data.length} ${type} transactions, filtered to ${filtered.length}`);
                    
                    if (filtered.length > 0) {
                        console.log(`📋 Filtered data (first 3):`, filtered.slice(0, 3));
                    }
                    
                    renderTransactions(type, filtered, state.totalCount);

                    // Refresh wallet chart/table when source data changes
                    const currentCurrency = document.getElementById('dashboardCurrencySelect')?.value || '';
                    const currentGateway = document.getElementById('dashboardGatewaySelect')?.value || null;
                    if (currentCurrency) {
                        updateWalletChart(currentCurrency, currentGateway);
                    }
                } else {
                    console.warn(`❌ Failed to load ${type}:`, result.message);
                    renderTransactions(type, [], 0);
                }
            } catch (error) {
                console.error(`❌ Error fetching ${type}:`, error);
                renderTransactions(type, [], 0);
            }
        }

