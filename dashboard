                            newOption.textContent = optData.text;
                            newOption.setAttribute('data-currency', optData.currency);
                            walletSelect.appendChild(newOption);
                            addedCount++;
                        }
                    });
                    
                    console.log(`Added ${addedCount} wallet options for currency: ${selectedCurrency}`);
                    
                    // Reset wallet selection
                    walletSelect.value = '';
