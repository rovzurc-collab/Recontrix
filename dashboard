            }
            
            // Format number with sign (negative values in parentheses)
            const formatAmount = (amount, isNegative = false) => {
                const absAmount = Math.abs(amount);
                const formatted = absAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                const display = isNegative && amount !== 0 ? `(${formatted})` : formatted;
                // Apply red color for any negative amount (shown with parentheses)
                if (amount < 0 && amount !== 0) {
                    return `<span style="color:#c0392b;">${display}</span>`;
                }
