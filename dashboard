        function saveShopBalanceRowFromModal() {
            const modal = document.getElementById('shopBalanceAddRowModal');
            const isEditMode = modal?.dataset.editMode === 'true';
            const originalRow = isEditMode ? JSON.parse(modal.dataset.originalRow || '{}') : {};

            const brand = (document.getElementById('shopBalanceModalBrand')?.value || '').trim().toUpperCase();
            const gateway = (document.getElementById('shopBalanceModalGateway')?.value || '').trim().toUpperCase();
            const currency = (document.getElementById('shopBalanceModalCurrency')?.value || '').trim().toUpperCase();
            const teamLeader = (document.getElementById('shopBalanceModalTeamLeader')?.value || '').trim().toUpperCase();
            const group = (document.getElementById('shopBalanceModalGroup')?.value || '').trim().toUpperCase();
            const shop = (document.getElementById('shopBalanceModalShop')?.value || '').trim().toUpperCase();

            if (!brand || !gateway || !currency || !shop) {
                alert('Brand, Gateway, Currency and Shop are required.');
                return;
            }

            if (isEditMode) {
                // Update existing row in window.shopBalanceResults
                if (Array.isArray(window.shopBalanceResults)) {
                    const index = window.shopBalanceResults.findIndex(r =>
                        r.brand === originalRow.brand && r.gateway === originalRow.gateway &&
                        r.currency === originalRow.currency && r.shop === originalRow.shop
                    );
                    if (index >= 0) {
                        // Update the row with new values
                        window.shopBalanceResults[index].brand = brand;
                        window.shopBalanceResults[index].gateway = gateway;
                        window.shopBalanceResults[index].currency = currency;
                        window.shopBalanceResults[index].teamLeader = teamLeader;
                        window.shopBalanceResults[index].group = group;
                        window.shopBalanceResults[index].shop = shop;
                        
                        console.log('Row updated:', window.shopBalanceResults[index]);
                        renderShopBalanceTable();
                    }
                }

                // Reset edit mode
                modal.dataset.editMode = 'false';
                delete modal.dataset.originalRow;

                // Reset modal title and button text
                const modalTitle = modal.querySelector('h2');
                if (modalTitle) modalTitle.textContent = 'Add Shop Balance';
                const submitBtn = modal.querySelector('button[type="submit"]');
                if (submitBtn) submitBtn.textContent = 'Add Shop';
            } else {
                // Add new row - original behavior
                const key = getShopBalanceKey(brand, gateway, currency, shop);
                window.shopBalanceMetaMap[key] = {
                    brand,
                    gateway,
                    currency,
                    teamLeader,
                    group,
                    shop
                };
                updateShopBalanceShopOptions();
            }

            closeShopBalanceAddRowModal();
            if (!isEditMode) {
                alert('Shop balance row metadata added. Click Search to refresh results.');
            } else {
                alert('Shop balance record updated successfully.');
            }
        }

        function handleShopBalanceImport(event) {
            const file = event.target.files?.[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = () => {
                try {
                    const text = String(reader.result || '');
                    const lines = text.split(/\r?\n/).filter(line => line.trim());
                    if (lines.length < 2) {
                        alert('Template import file is empty.');
                        return;
                    }

                    const header = parseCsvLine(lines[0]).map(h => normalizeFilterValue(h));
                    const required = ['brand', 'gateway', 'currency', 'team leader', 'group', 'shop'];
                    const idx = {};
                    required.forEach(col => {
                        idx[col] = header.findIndex(h => h === col);
                    });
                    if (required.some(col => idx[col] < 0)) {
                        alert('Invalid template columns. Required: Brand, Gateway, Currency, Team Leader, Group, Shop');
                        return;
                    }

                    let imported = 0;
                    for (let i = 1; i < lines.length; i++) {
                        const parts = parseCsvLine(lines[i]);
                        const brand = (parts[idx['brand']] || '').trim();
                        const gateway = (parts[idx['gateway']] || '').trim();
                        const currency = (parts[idx['currency']] || '').trim();
                        const teamLeader = (parts[idx['team leader']] || '').trim();
                        const group = (parts[idx['group']] || '').trim();
                        const shop = (parts[idx['shop']] || '').trim();
                        if (!brand || !gateway || !currency || !shop) continue;

                        const key = getShopBalanceKey(brand, gateway, currency, shop);
                        window.shopBalanceMetaMap[key] = { brand, gateway, currency, teamLeader, group, shop };
                        imported++;
                    }

                    updateShopBalanceShopOptions();
                    alert(`Imported ${imported} shop balance metadata rows.`);
                } catch (error) {
                    alert('Import failed: ' + error.message);
                } finally {
                    event.target.value = '';
                }
            };
            reader.readAsText(file);
        }

        function updateShopBalanceShopOptions() {
            const shopInput = document.getElementById('shopBalanceShopFilter');
            if (!shopInput) return;
            shopInput.value = (shopInput.value || '').trim();
        }

        // Shop Balance Search Function - Fetches from transaction data
        async function searchShopBalance() {
            const month = document.getElementById('shopBalanceMonth')?.value || '';
            const year = document.getElementById('shopBalanceYear')?.value || '';
            if (!month || !year) {
                alert('Please select Month and Year.');
                return;
            }

            const currencyValue = document.getElementById('shopBalanceCurrencyFilter')?.value || '';
            if (!currencyValue) {
                alert('Please select a Currency first.');
                return;
            }

            // CRITICAL: Normalize "All X" filter values to empty strings (means no filter)
            let brand = String(document.getElementById('shopBalanceBrandFilter')?.value || '').trim();
            let currency = String(currencyValue).trim();  // Currency is REQUIRED, don't normalize
            let gateway = String(document.getElementById('shopBalanceGatewayFilter')?.value || '').trim();
            let wallet = String(document.getElementById('shopBalanceWalletFilter')?.value || '').trim();
            let shopFilter = String(document.getElementById('shopBalanceShopFilter')?.value || '').trim();
            
            console.log('🔍 RAW filter values from HTML:', { brand, currency, gateway, wallet, shopFilter });
            
            // Normalize "All X" values to empty strings (allows all values to match)
            if (brand.toLowerCase().includes('all')) {
                console.log(`  Normalizing brand: "${brand}" → ""(all brands enabled)`);
                brand = '';
            }
            // NOTE: currency is REQUIRED and not normalized
            if (gateway.toLowerCase().includes('all')) {
                console.log(`  Normalizing gateway: "${gateway}" → "" (all gateways enabled)`);
                gateway = '';
            }
            if (wallet.toLowerCase().includes('all')) {
                console.log(`  Normalizing wallet: "${wallet}" → "" (all wallets enabled)`);
                wallet = '';
            }
            if (shopFilter.toLowerCase().includes('all')) {
                console.log(`  Normalizing shop: "${shopFilter}" → "" (all shops enabled)`);
                shopFilter = '';
            }

            console.log('🔍 NORMALIZED filter values:', { 
                month, year, 
                brand: brand || '(all)', 
                currency: currency || '(all)', 
                gateway: gateway || '(all)', 
                wallet: wallet || '(all)', 
                shop: shopFilter || '(all)' 
            });

            try {
                showLoadingOverlay();

                // CRITICAL: Ensure transaction data is loaded before proceeding
                console.log('⏳ Checking if transaction data is loaded...');
                const txData = window.originalTransactionData || {};
                
                console.log('📊 Current state of txData:');
                console.log('   - deposit array length:', (txData.deposit || []).length);
                console.log('   - withdrawal array length:', (txData.withdrawal || []).length);
                console.log('   - adjustment array length:', (txData.adjustment || []).length);
                console.log('   - txData keys:', Object.keys(txData));
                
                // If data not loaded, fetch it NOW before proceeding
                if (!txData.deposit || txData.deposit.length === 0 || !txData.withdrawal || txData.withdrawal.length === 0) {
                    console.log('📥 Loading transaction data...');
                    
                    // Fetch all transaction types
                    const endpoints = [
                        { type: 'deposit', url: '/api/deposits' },
                        { type: 'withdrawal', url: '/api/withdrawals' },
                        { type: 'adjustment', url: '/api/adjustments' }
                    ];
                    
                    for (const endpoint of endpoints) {
                        try {
                            console.log(`📥 Fetching ${endpoint.type} from ${endpoint.url}...`);
                            const fetchUrl = endpoint.type === 'adjustment' ? endpoint.url : `${endpoint.url}?page=1&page_size=50000`;
                            const res = await fetch(fetchUrl);
                            const result = await res.json();
                            
                            if (result.success && Array.isArray(result.data)) {
                                txData[endpoint.type] = result.data;
                                console.log(`✅ Loaded ${result.data.length} ${endpoint.type} records`);
                                if (result.data.length > 0) {
                                    console.log(`📋 First ${endpoint.type}:`, result.data[0]);
                                }
                            } else {
                                console.warn(`⚠️ Failed to load ${endpoint.type}:`, result);
                                txData[endpoint.type] = [];
                            }
                        } catch (err) {
                            console.error(`❌ Error loading ${endpoint.type}:`, err.message);
                            txData[endpoint.type] = [];
                        }
                    }
                    
                    // Update window reference
                    window.originalTransactionData = txData;
                    console.log('✅ Transaction data now loaded');
                }

                console.log('📦 Final transaction data state:', {
                    deposits: (txData.deposit || []).length,
                    withdrawals: (txData.withdrawal || []).length,
                    adjustments: (txData.adjustment || []).length
                });

                if ((!txData.deposit || txData.deposit.length === 0) && 
                    (!txData.withdrawal || txData.withdrawal.length === 0) && 
                    (!txData.adjustment || txData.adjustment.length === 0)) {
                    console.error('❌ All transaction arrays are empty!');
                    alert('No transaction data available. Please check if data is loading.');
                    hideLoadingOverlay();
                    return;
                }

                // Get month range to determine which transactions to include
                const monthNum = parseInt(month, 10);
                const yearNum = parseInt(year, 10);
                const fromDate = new Date(yearNum, monthNum - 1, 1, 0, 0, 0);
                const toDate = new Date(yearNum, monthNum, 0, 23, 59, 59);
                
                console.log(`📅 Month range: from=${fromDate.toString()}, to=${toDate.toString()}`);
                
                const inMonth = (dateStr) => {
                    if (!dateStr) return false;
                    const dateObj = parseTxnDate(dateStr);
                    if (!dateObj) {
                        return false;
                    }
                    const result = dateObj >= fromDate && dateObj <= toDate;
                    return result;
                };

                const inPreviousMonths = (dateStr) => {
                    if (!dateStr) return false;
                    const dateObj = parseTxnDate(dateStr);
                    if (!dateObj) return false;
                    return dateObj < fromDate;  // Before current month = previous months
                };

                const parseAmount = (val) => {
                    const num = parseFloat(val);
                    return Number.isNaN(num) ? 0 : num;
                };

                // Group transactions by (brand, gateway, currency, shop)
                const shopMap = new Map();
                const getKey = (tx) => `${tx.brand || '-'}|||${tx.gateway || '-'}|||${tx.currency || '-'}|||${tx.shop || '-'}`;

                console.log('📊 Calculating per-shop opening balances from all transactions BEFORE current month...');
                const shopOpeningBalances = new Map();  // key -> running balance before current month
                const shopSecurityDeposits = new Map();  // key -> accumulated security deposits

                // First pass: Calculate opening balance for each shop from previous months' transactions
                (txData.deposit || []).forEach(tx => {
                    // Match monthly report logic: exclude MERGED and Voided only
                    if (tx.source_file === 'MERGED') return;
                    if ((tx.status || '').toLowerCase() === 'voided') return;
                    const txDate = tx.gateway_date || tx.backoffice_date;
                    if (!txDate) return;
                    
                    if (!inPreviousMonths(txDate)) return;
                    
                    const currencyMatch = !currency || (tx.currency || '') === currency;
                    const brandMatch = !brand || (tx.brand || '') === brand;
                    const gatewayMatch = !gateway || (tx.gateway || '') === gateway;
                    const walletMatch = !wallet || (tx.wallet || '') === wallet;
                    const shopMatch = !shopFilter || (tx.shop || '') === shopFilter;
                    
                    if (!currencyMatch || !brandMatch || !gatewayMatch || !walletMatch || !shopMatch) return;
                    
                    const key = getKey(tx);
                    const current = shopOpeningBalances.get(key) || 0;
                    shopOpeningBalances.set(key, current + parseAmount(tx.amount || 0));
                    
                    // Subtract deposit fee from opening balance
                    const depositFee = parseAmount(tx.fee || 0);
                    if (depositFee > 0) {
                        shopOpeningBalances.set(key, (shopOpeningBalances.get(key) || 0) - depositFee);
                    }
                });

                (txData.withdrawal || []).forEach(tx => {
                    // Match monthly report logic: exclude MERGED and Voided only
                    if (tx.source_file === 'MERGED') return;
                    if ((tx.status || '').toLowerCase() === 'voided') return;
                    const txDate = tx.gateway_date || tx.backoffice_date;
                    if (!txDate) return;
                    
                    if (!inPreviousMonths(txDate)) return;
                    
                    const currencyMatch = !currency || (tx.currency || '') === currency;
                    const brandMatch = !brand || (tx.brand || '') === brand;
                    const gatewayMatch = !gateway || (tx.gateway || '') === gateway;
                    const walletMatch = !wallet || (tx.wallet || '') === wallet;
                    const shopMatch = !shopFilter || (tx.shop || '') === shopFilter;
                    
                    if (!currencyMatch || !brandMatch || !gatewayMatch || !walletMatch || !shopMatch) return;
                    
                    const key = getKey(tx);
                    const current = shopOpeningBalances.get(key) || 0;
                    shopOpeningBalances.set(key, current - parseAmount(tx.amount || 0));
                    
                    // Subtract withdrawal fee from opening balance
                    const withdrawalFee = parseAmount(tx.fee || 0);
                    if (withdrawalFee > 0) {
                        shopOpeningBalances.set(key, (shopOpeningBalances.get(key) || 0) - withdrawalFee);
                    }
                });

                (txData.adjustment || []).forEach(tx => {
                    // Match monthly report logic: exclude MERGED
                    if (tx.source_file === 'MERGED') return;
                    if (!tx.gateway_date) return;  // Adjustments use gateway_date only
                    
                    if (!inPreviousMonths(tx.gateway_date)) return;
                    
                    const currencyMatch = !currency || (tx.currency || '') === currency;
                    const brandMatch = !brand || (tx.brand || '') === brand;
                    const gatewayMatch = !gateway || (tx.gateway || '') === gateway;
                    const walletMatch = !wallet || (tx.wallet || '') === wallet;
                    const shopMatch = !shopFilter || (tx.shop || '') === shopFilter;
                    
                    if (!currencyMatch || !brandMatch || !gatewayMatch || !walletMatch || !shopMatch) return;
                    
                    const key = getKey(tx);
                    const amount = parseAmount(tx.amount || 0);
                    const type = (tx.type || '').toUpperCase();
                    
                    let adjustment = 0;
                    if (type.includes('FUND TRANSFER IN')) adjustment = amount;
                    else if (type.includes('FUND TRANSFER OUT')) adjustment = -amount;
                    else if (type.includes('SPECIAL PAYMENT')) adjustment = -amount;
                    else if (type.includes('SETTLEMENT')) adjustment = -amount;
                    else if (type.includes('FEE')) adjustment = -amount;
                    else if (type.includes('ADJUSTMENT IN')) adjustment = amount;
                    else if (type.includes('ADJUSTMENT OUT')) adjustment = -amount;
                    else if (type.includes('SECURITY DEPOSIT')) {
                        adjustment = 0;
                        const deposit = shopSecurityDeposits.get(key) || 0;
                        shopSecurityDeposits.set(key, deposit + amount);
                    }
                    else if (type.includes('COMMISSION')) adjustment = -amount;
                    
                    const current = shopOpeningBalances.get(key) || 0;
                    shopOpeningBalances.set(key, current + adjustment);
                });

                console.log(`✅ Calculated opening balances for ${shopOpeningBalances.size} shops from previous months data`);
                if (shopOpeningBalances.size > 0) {
                    const samples = Array.from(shopOpeningBalances.entries()).slice(0, 3);
                    console.log(`📋 Sample opening balances:`, samples);
                }

                let totalProcessed = 0;
                let totalMatched = 0;

                // CRITICAL: Scan ALL transaction data (regardless of month) to find ALL unique shops
                // and pre-populate them so shops with zero current month transactions still appear
                console.log('🔍 Scanning all transaction data to discover all shops...');
                const allShopsSet = new Set();
                
                [...(txData.deposit || []), ...(txData.withdrawal || []), ...(txData.adjustment || [])].forEach(tx => {
                    // Match monthly report logic: exclude MERGED and Voided only
                    if (tx.source_file === 'MERGED') return;
                    if ((tx.status || '').toLowerCase() === 'voided') return;
                    const txDate = tx.gateway_date || tx.backoffice_date;
                    if (!txDate) return;
                    
                    if (tx.brand && tx.gateway && tx.currency && tx.shop) {
                        const key = getKey(tx);
                        allShopsSet.add(key);
                        
                        // Also check if this matches current filters
                        const currencyMatch = !currency || (tx.currency || '') === currency;
                        const brandMatch = !brand || (tx.brand || '') === brand;
                        const gatewayMatch = !gateway || (tx.gateway || '') === gateway;
                        const walletMatch = !wallet || (tx.wallet || '') === wallet;
                        const shopMatch = !shopFilter || (tx.shop || '') === shopFilter;
                        
                        if (currencyMatch && brandMatch && gatewayMatch && walletMatch && shopMatch) {
                            // Pre-create entry for this shop (will be updated with transaction data)
                            if (!shopMap.has(key)) {
                                const metaKey = getShopBalanceKey(tx.brand, tx.gateway, tx.currency, tx.shop);
                                const meta = window.shopBalanceMetaMap?.[metaKey] || {};
                                shopMap.set(key, {
                                    brand: String(tx.brand || '-').trim(),
                                    gateway: String(tx.gateway || '-').trim(),
                                    currency: String(tx.currency || '-').trim(),
                                    teamLeader: String(meta.teamLeader || '-').trim(),
                                    group: String(meta.group || '-').trim(),
                                    shop: String(tx.shop || '-').trim(),
                                    securityDeposit: 0,
                                    openingBalance: 0,
                                    totalDeposit: 0,
                                    totalWithdrawal: 0,
                                    totalAdjustment: 0,
                                    fundTransferIn: 0,
                                    fundTransferOut: 0,
                                    specialPayment: 0,
                                    settlement: 0,
                                    fee: 0,
                                    adjustmentIn: 0,
                                    adjustmentOut: 0,
                                    commission: 0,
                                    closingBalance: 0,
                                    activeDates: new Set(),
                                    activeDays: 0
                                });
                            }
                        }
                    }
                });
                
                console.log(`✅ Discovered ${allShopsSet.size} total unique shops, pre-populated ${shopMap.size} matching current filters`);


                // Process deposits
                console.log(`🏦 Processing ${(txData.deposit || []).length} deposits...`);
                (txData.deposit || []).forEach((tx, idx) => {
                    totalProcessed++;
                    
                    // Match monthly report logic: exclude MERGED and Voided only
                    if (tx.source_file === 'MERGED') return;
                    if ((tx.status || '').toLowerCase() === 'voided') return;
                    const txDate = tx.gateway_date || tx.backoffice_date;
                    if (!txDate) return;
                    
                    const dateMatch = inMonth(txDate);
                    if (!dateMatch) return;
                    
                    const currencyMatch = !currency || (tx.currency || '') === currency;
                    if (!currencyMatch) return;
                    
                    const brandMatch = !brand || (tx.brand || '') === brand;
                    const gatewayMatch = !gateway || (tx.gateway || '') === gateway;
                    const walletMatch = !wallet || (tx.wallet || '') === wallet;
                    const shopMatch = !shopFilter || (tx.shop || '') === shopFilter;

                    if (!brandMatch || !gatewayMatch || !walletMatch || !shopMatch) return;

                    totalMatched++;
                    const key = getKey(tx);
                    if (!shopMap.has(key)) {
                        const metaKey = getShopBalanceKey(tx.brand, tx.gateway, tx.currency, tx.shop);
                        const meta = window.shopBalanceMetaMap?.[metaKey] || {};
                        shopMap.set(key, {
                            brand: String(tx.brand || '-').trim(),
                            gateway: String(tx.gateway || '-').trim(),
                            currency: String(tx.currency || '-').trim(),
                            teamLeader: String(meta.teamLeader || '-').trim(),
                            group: String(meta.group || '-').trim(),
                            shop: String(tx.shop || '-').trim(),
                            securityDeposit: 0,
                            openingBalance: 0,
                            totalDeposit: 0,
                            totalWithdrawal: 0,
                            totalAdjustment: 0,
                            fundTransferIn: 0,
                            fundTransferOut: 0,
                            specialPayment: 0,
                            settlement: 0,
                            fee: 0,
                            adjustmentIn: 0,
                            adjustmentOut: 0,
                            commission: 0,
                            closingBalance: 0,
                            activeDates: new Set(),
                            activeDays: 0
                        });
                    }
                    const shop = shopMap.get(key);
                    shop.totalDeposit += parseAmount(tx.amount || 0);
                    
                    // Track active day for this shop (deposit counts as active)
                    const depDate = String(txDate || '').slice(0, 10);
                    if (depDate && shop.activeDates) shop.activeDates.add(depDate);
                    
                    // Add deposit fee to Total Adjustment (negative) and Fee breakdown
                    const depositFee = parseAmount(tx.fee || 0);
                    if (depositFee > 0) {
                        shop.fee += depositFee;
                        shop.totalAdjustment -= depositFee;  // Fees are negative adjustments
                    }
                });
                console.log(`✅ Deposits: processed=${totalProcessed}, matched=${totalMatched}`);

                totalProcessed = 0;
                totalMatched = 0;

                // Process withdrawals
                console.log(`🏦 Processing ${(txData.withdrawal || []).length} withdrawals...`);
                (txData.withdrawal || []).forEach((tx, idx) => {
                    totalProcessed++;
                    
                    // Match monthly report logic: exclude MERGED and Voided only
                    if (tx.source_file === 'MERGED') return;
                    if ((tx.status || '').toLowerCase() === 'voided') return;
                    const txDate = tx.gateway_date || tx.backoffice_date;
                    if (!txDate) return;
                    
                    const dateMatch = inMonth(txDate);
                    if (!dateMatch) return;
                    
                    const currencyMatch = !currency || (tx.currency || '') === currency;
                    if (!currencyMatch) return;
                    
                    const brandMatch = !brand || (tx.brand || '') === brand;
                    const gatewayMatch = !gateway || (tx.gateway || '') === gateway;
                    const walletMatch = !wallet || (tx.wallet || '') === wallet;
                    const shopMatch = !shopFilter || (tx.shop || '') === shopFilter;

                    if (!brandMatch || !gatewayMatch || !walletMatch || !shopMatch) return;

                    totalMatched++;
                    const key = getKey(tx);
                    if (!shopMap.has(key)) {
                        const metaKey = getShopBalanceKey(tx.brand, tx.gateway, tx.currency, tx.shop);
                        const meta = window.shopBalanceMetaMap?.[metaKey] || {};
                        shopMap.set(key, {
                            brand: String(tx.brand || '-').trim(),
                            gateway: String(tx.gateway || '-').trim(),
                            currency: String(tx.currency || '-').trim(),
                            teamLeader: String(meta.teamLeader || '-').trim(),
                            group: String(meta.group || '-').trim(),
                            shop: String(tx.shop || '-').trim(),
                            securityDeposit: 0,
                            openingBalance: 0,
                            totalDeposit: 0,
                            totalWithdrawal: 0,
                            totalAdjustment: 0,
                            fundTransferIn: 0,
                            fundTransferOut: 0,
                            specialPayment: 0,
                            settlement: 0,
                            fee: 0,
                            adjustmentIn: 0,
                            adjustmentOut: 0,
                            commission: 0,
                            closingBalance: 0,
                            activeDates: new Set(),
                            activeDays: 0
                        });
                    }
                    const shop = shopMap.get(key);
                    shop.totalWithdrawal += parseAmount(tx.amount || 0);
                    
                    // Track active day for this shop (withdrawal counts as active)
                    const wdDate = String(txDate || '').slice(0, 10);
                    if (wdDate && shop.activeDates) shop.activeDates.add(wdDate);
                    
                    // Add withdrawal fee to Total Adjustment (negative) and Fee breakdown
                    const withdrawalFee = parseAmount(tx.fee || 0);
                    if (withdrawalFee > 0) {
                        shop.fee += withdrawalFee;
                        shop.totalAdjustment -= withdrawalFee;  // Fees are negative adjustments
                    }
                });
                console.log(`✅ Withdrawals: processed=${totalProcessed}, matched=${totalMatched}`);

                // Process adjustments WITH DATE FILTER
                let adjustmentMatches = 0;
                (txData.adjustment || []).forEach((tx, idx) => {
                    // Match monthly report logic: exclude MERGED
                    if (tx.source_file === 'MERGED') return;
                    if (!tx.gateway_date) return;  // Adjustments use gateway_date only
                    
                    const dateMatch = inMonth(tx.gateway_date);
                    
                    if (!dateMatch) {
                        return;
                    }
                    
                    const currencyMatch = !currency || (tx.currency || '') === currency;
                    const brandMatch = !brand || (tx.brand || '') === brand;
                    const gatewayMatch = !gateway || (tx.gateway || '') === gateway;
                    const walletMatch = !wallet || (tx.wallet || '') === wallet;
                    const shopMatch = !shopFilter || (tx.shop || '') === shopFilter;

                    const allFiltersMatch = currencyMatch && brandMatch && gatewayMatch && walletMatch && shopMatch;
                    if (!allFiltersMatch) return;
                    
                    adjustmentMatches++;

                    const key = getKey(tx);
                    if (!shopMap.has(key)) {
                        const metaKey = getShopBalanceKey(tx.brand, tx.gateway, tx.currency, tx.shop);
                        const meta = window.shopBalanceMetaMap?.[metaKey] || {};
                        shopMap.set(key, {
                            brand: String(tx.brand || '-').trim(),
                            gateway: String(tx.gateway || '-').trim(),
                            currency: String(tx.currency || '-').trim(),
                            teamLeader: String(meta.teamLeader || '-').trim(),
                            group: String(meta.group || '-').trim(),
                            shop: String(tx.shop || '-').trim(),
                            securityDeposit: 0,
                            openingBalance: 0,
                            totalDeposit: 0,
                            totalWithdrawal: 0,
                            totalAdjustment: 0,
                            fundTransferIn: 0,
                            fundTransferOut: 0,
                            specialPayment: 0,
                            settlement: 0,
                            fee: 0,
                            adjustmentIn: 0,
                            adjustmentOut: 0,
                            commission: 0,
                            closingBalance: 0,
                            activeDates: new Set(),
                            activeDays: 0
                        });
                    }
                    const shop = shopMap.get(key);
                    if (!shop) {
                        console.error(`❌ CRITICAL: Could not get shop from map for key: ${key}`);
                        return;
                    }
                    const amount = parseAmount(tx.amount || 0);
                    const type = (tx.type || '').toUpperCase();

                    if (type.includes('FUND TRANSFER IN')) shop.fundTransferIn += amount;
                    else if (type.includes('FUND TRANSFER OUT')) shop.fundTransferOut -= amount;
                    else if (type.includes('SPECIAL PAYMENT')) shop.specialPayment -= amount;
                    else if (type.includes('SETTLEMENT')) shop.settlement -= amount;
                    else if (type.includes('FEE')) shop.fee -= amount;
                    else if (type.includes('ADJUSTMENT IN')) shop.adjustmentIn += amount;
                    else if (type.includes('ADJUSTMENT OUT')) shop.adjustmentOut -= amount;
                    else if (type.includes('SECURITY DEPOSIT')) shop.securityDeposit += amount;
                    else if (type.includes('COMMISSION')) shop.commission -= amount;

                    shop.totalAdjustment = shop.fundTransferIn + shop.fundTransferOut + shop.specialPayment + shop.settlement + shop.fee + shop.adjustmentIn + shop.adjustmentOut + shop.commission;
                });

                // Apply opening balance to all shops
                shopMap.forEach((shop, key) => {
                    shop.openingBalance = shopOpeningBalances.get(key) || 0;
                    const openingSecurityDeposit = shopSecurityDeposits.get(key) || 0;
                    const currentMonthSecurityDeposit = shop.securityDeposit || 0;
                    shop.securityDeposit = openingSecurityDeposit + currentMonthSecurityDeposit;
                });

                // Calculate closing balance
                shopMap.forEach(shop => {
                    shop.closingBalance = shop.openingBalance + shop.totalDeposit - shop.totalWithdrawal + shop.totalAdjustment;
                    // Finalize active days count from tracked dates
                    shop.activeDays = shop.activeDates ? shop.activeDates.size : 0;
                });

                const rows = Array.from(shopMap.values());
                window.shopBalanceResults = rows;
                window.shopBalanceCurrentPage = 1;
                
                console.log('✅ Shop balance data processed:', rows.length, 'shops');
                if (rows.length > 0) {
                    console.log('📊 First shop:', rows[0]);
                }
                renderShopBalanceTable();

                hideLoadingOverlay();
            } catch (error) {
                console.error('❌ Error searching shop balance:', error);
                hideLoadingOverlay();
                alert('Error loading shop balance data: ' + error.message);
            }
        }

        function exportShopBalance() {
            const rows = sortShopBalanceRows(Array.isArray(window.shopBalanceResults) ? [...window.shopBalanceResults] : []);
            if (!rows.length) {
                alert('No shop balance data to export. Please search first.');
                return;
            }

            const escapeCsv = (value) => {
                const text = String(value ?? '');
                if (text.includes(',') || text.includes('"') || text.includes('\n')) {
                    return `"${text.replace(/"/g, '""')}"`;
                }
                return text;
            };

            const header = [
                'Brand', 'Gateway', 'Currency', 'Team Leader', 'Group', 'Shop',
                'Security Deposit', 'Opening Balance', 'Total Deposit', 'Total Withdrawal', 'Total Adjustment', 'Closing Balance', 'Total Active Days'
            ];
            const lines = [header.join(',')];
            rows.forEach(row => {
                lines.push([
                    escapeCsv(row.brand),
                    escapeCsv(row.gateway),
                    escapeCsv(row.currency),
                    escapeCsv(row.teamLeader),
                    escapeCsv(row.group),
                    escapeCsv(row.shop),
                    Number(row.securityDeposit || 0).toFixed(2),
                    Number(row.openingBalance || 0).toFixed(2),
                    Number(row.totalDeposit || 0).toFixed(2),
                    Number(row.totalWithdrawal || 0).toFixed(2),
                    Number(row.totalAdjustment || 0).toFixed(2),
                    Number(row.closingBalance || 0).toFixed(2),
                    Number(row.activeDays || 0)
                ].join(','));
            });

            const csv = lines.join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            const stamp = new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-');
            link.href = url;
            link.download = `shop_balance_${stamp}.csv`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }
        
