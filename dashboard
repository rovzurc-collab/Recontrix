            // Function to enforce brand access control for non-admin users
            function enforceBrandAccessControl() {
                const brandSelectIds = [
                    'dashboardBrandSelect',
                    'depositBrandFilter',
                    'withdrawalBrandFilter',
                    'adjustmentBrandFilter',
                    'monthlyReportBrand',
                    'adjBrand',
                    'shopBalanceBrandFilter',
                    'shopBalanceModalBrand'
                ];

                const allowedBrands = window.userAccessControl.allowedBrands || [];
                const allowedBrandSet = new Set(allowedBrands.map(b => String(b).toUpperCase()));

                if (allowedBrandSet.size === 0) {
                    return;
                }

                brandSelectIds.forEach(selectId => {
                    const select = document.getElementById(selectId);
                    if (!select) return;

                    console.log(`[ACCESS CONTROL] Cleaning brand options for ${selectId}`);

                    for (let i = select.options.length - 1; i >= 0; i--) {
                        const option = select.options[i];
                        const value = String(option.value || '').toUpperCase();

                        if (value === '') {
                            continue;
                        }

                        if (!allowedBrandSet.has(value)) {
                            console.log(`[ACCESS CONTROL]   ❌ Removing unauthorized brand: ${value}`);
                            select.remove(i);
                        }
                    }

                    select.value = '';
                });
            }

            function normalizeGatewayKey(value) {
                return String(value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
            }

            // Hide unauthorized currency sections and gateway rows in Import Files
            function enforceImportAccessControl() {
                const allowedCurrencies = window.userAccessControl.allowedCurrencies || [];
                const allowedGateways = window.userAccessControl.allowedGateways || [];

                const allowedCurrencySet = new Set(allowedCurrencies.map(c => String(c).toUpperCase()));
                const allowedGatewaySet = new Set(allowedGateways.map(g => normalizeGatewayKey(g)));

                document.querySelectorAll('.import-currency-section').forEach(section => {
                    const currency = String(section.dataset.currency || '').toUpperCase();

                    if (allowedCurrencySet.size > 0 && currency && !allowedCurrencySet.has(currency)) {
                        section.style.display = 'none';
                        return;
                    }

                    // If gateways are restricted, hide rows not allowed
                    if (allowedGatewaySet.size > 0) {
                        section.querySelectorAll('tr').forEach(row => {
                            const dropzone = row.querySelector('.dropzone');
                            const fileType = dropzone?.dataset.filetype || '';
                            const parts = String(fileType).split('_');

                            if (parts.length < 2) return;

                            const rowCurrency = String(parts.shift() || '').toUpperCase();
                            const gatewayName = parts.join('_');
                            const gatewayKey = normalizeGatewayKey(gatewayName);
                            const gatewayKeyWithCurrency = normalizeGatewayKey(`${rowCurrency}::${gatewayName}`);

                            if (rowCurrency === currency && !allowedGatewaySet.has(gatewayKeyWithCurrency) && !allowedGatewaySet.has(gatewayKey)) {
                                row.style.display = 'none';
                            }
                        });
                    }
                });
