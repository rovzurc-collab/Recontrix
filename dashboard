        // Convert UTC times to local browser time
        function convertLocalTimes() {
            const cells = document.querySelectorAll('.local-time-cell');
            cells.forEach(cell => {
                const timeStr = cell.getAttribute('data-time');
                if (timeStr) {
                    try {
                        // Parse the time string (format: YYYY-MM-DD HH:MM:SS)
                        // Interpret as UTC and convert to local time
                        const [datePart, timePart] = timeStr.split(' ');
                        const [year, month, day] = datePart.split('-');
                        const [hour, minute, second] = timePart.split(':');
                        
                        // Create UTC date object
                        const utcDate = new Date(Date.UTC(year, month - 1, day, hour, minute, second));
                        
                        // Format as local time: YYYY-MM-DD HH:MM:SS
                        const localYear = utcDate.getFullYear();
                        const localMonth = String(utcDate.getMonth() + 1).padStart(2, '0');
