        function getExportTimestamp() {
            const now = new Date();
            const pad = (value) => String(value).padStart(2, '0');
            return `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
        }

        function escapeCsvCell(value) {
            const text = String(value ?? '').replace(/\r?\n/g, ' ').trim();
            if (text.includes(',') || text.includes('"')) {
                return `"${text.replace(/"/g, '""')}"`;
            }
            return text;
        }

        function downloadCsvFile(filename, headers, rows) {
            const csvLines = [
                headers.map(escapeCsvCell).join(','),
                ...rows.map(row => row.map(escapeCsvCell).join(','))
            ];
            const blob = new Blob([csvLines.join('\n')], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        }

        async function exportSearchedTransactions(type) {
            const endpoints = { deposit: '/api/deposits', withdrawal: '/api/withdrawals', adjustment: '/api/adjustments' };
            const endpoint = endpoints[type];
            if (!endpoint) return;

            const isAdjustment = type === 'adjustment';

            // For deposit/withdrawal: fetch ALL records from server (not just current page)
            let allData;
            if (isAdjustment) {
                allData = Array.isArray(transactionStore[type]) ? transactionStore[type] : [];
            } else {
                try {
                    showLoadingOverlay();
                    const params = new URLSearchParams();
                    params.set('page', '1');
                    params.set('page_size', '50000');
                    params.set('_', Date.now());
                    const res = await fetch(`${endpoint}?${params.toString()}`);
                    const result = await res.json();
                    if (result.success && Array.isArray(result.data)) {
                        allData = result.data;
                    } else {
                        hideLoadingOverlay();
                        alert(`Failed to fetch ${type} transactions for export.`);
                        return;
                    }
                } catch (err) {
                    hideLoadingOverlay();
                    alert(`Error fetching ${type} data: ${err.message}`);
                    return;
                }
            }

            // Apply current search/filter criteria
            const filtered = applyFilters(type, allData);

            // Apply current sort
            const state = getTableState(type);
            const sorted = sortRecords(filtered, state);

            if (!isAdjustment) hideLoadingOverlay();

            if (!sorted.length) {
                alert(`No ${type} transactions to export.`);
                return;
            }

            const headers = isAdjustment
                ? ['Brand', 'Gateway', 'Currency', 'Wallet', 'Shop', 'Amount', 'Fee', 'Type', 'Gateway Date', 'Remarks', 'Status', 'Source File']
                : ['Brand', 'Gateway', 'Currency', 'Wallet', 'Transaction ID', 'Reference Number', 'Shop', 'Amount', 'Fee', 'Status', 'Gateway Date', 'Backoffice Date', 'Source File'];

            const csvRows = sorted.map(tx => {
                if (isAdjustment) {
                    return [
                        tx.brand || '',
                        tx.gateway || '',
                        tx.currency || '',
                        tx.wallet || '',
                        tx.shop || '',
                        tx.amount ?? '',
                        tx.fee ?? '',
                        tx.type || '',
                        tx.gateway_date || '',
                        tx.remarks || '',
                        tx.status || '',
                        tx.source_file || ''
                    ];
                }

                return [
                    tx.brand || '',
                    tx.gateway || '',
                    tx.currency || '',
                    tx.wallet || '',
                    tx.transaction_id || '',
                    tx.reference_number || '',
                    tx.shop || '',
                    tx.amount ?? '',
                    tx.fee ?? '',
                    tx.status || '',
                    tx.gateway_date || '',
                    tx.backoffice_date || '',
                    tx.source_file || ''
                ];
            });

            downloadCsvFile(`${type}_transactions_${getExportTimestamp()}.csv`, headers, csvRows);
        }

