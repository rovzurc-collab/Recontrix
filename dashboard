        function parseTxnDate(value) {
            if (!value) return null;
            const text = String(value).trim();
            if (!text) return null;

            const buildSafeDate = (year, month, day) => {
                const parsedYear = Number(year);
                const parsedMonth = Number(month);
                const parsedDay = Number(day);
                if (!Number.isInteger(parsedYear) || !Number.isInteger(parsedMonth) || !Number.isInteger(parsedDay)) return null;
                if (parsedMonth < 1 || parsedMonth > 12) return null;
                if (parsedDay < 1 || parsedDay > 31) return null;

                const candidate = new Date(parsedYear, parsedMonth - 1, parsedDay, 0, 0, 0, 0);
                if (candidate.getFullYear() !== parsedYear) return null;
                if (candidate.getMonth() !== parsedMonth - 1) return null;
                if (candidate.getDate() !== parsedDay) return null;
                return candidate;
            };

            if (/^\d{2}\/\d{2}\/\d{4}/.test(text)) {
                const [part1, part2, year] = text.slice(0, 10).split('/').map(Number);

                // Auto-detect slash format:
                // - If first part > 12 => DD/MM/YYYY
                // - If second part > 12 => MM/DD/YYYY
                // - If ambiguous (both <= 12), keep existing behavior (MM/DD/YYYY)
                if (part1 > 12 && part2 <= 12) {
                    return buildSafeDate(year, part2, part1);
                }
                return buildSafeDate(year, part1, part2);
            }

            if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
                const [year, month, day] = text.slice(0, 10).split('-').map(Number);
                return buildSafeDate(year, month, day);
            }

            const parsed = Date.parse(text);
            if (!Number.isNaN(parsed)) {
                return new Date(parsed);
            }
            return null;
        }

