                        </select>
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Gateway</label>
                        <select id="monthlyReportGateway" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                            <option value="">All Gateways</option>
                            {% for currency in currencies %}
                                {% if gateways and gateways.get(currency.code) %}
                                    {% for gateway in gateways[currency.code] %}
                                    <option value="{{ gateway.name }}" data-currency="{{ currency.code }}">{{ gateway.name }}</option>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label style="display:block; font-size:12px; color:#666; margin-bottom:5px;">Wallet</label>
                        <select id="monthlyReportWallet" style="width:100%; padding:8px; border:1px solid #ccc; border-radius:4px;">
                            <option value="">All Wallets</option>
                            {% if wallets %}
                                {% for currency, wallet_list in wallets.items() %}
                                    {% for wallet in wallet_list %}
                                    <option value="{{ wallet.name }}" data-currency="{{ currency }}">{{ wallet.name }}</option>
                                    {% endfor %}
                                {% endfor %}
                            {% endif %}
                        </select>
                    </div>
                </div>
                <div style="display:flex; gap:10px; align-items:center; justify-content:flex-start; width:100%;">
                    <button type="button" onclick="generateMonthlyReport()" style="background: linear-gradient(135deg, #ff9500 0%, #ffa500 100%); border:none; padding:10px 12px; border-radius:4px; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; transition: all 0.3s ease;" title="Generate Report" onmouseover="this.style.background='linear-gradient(135deg, #ff8c00 0%, #ff9500 100%)'" onmouseout="this.style.background='linear-gradient(135deg, #ff9500 0%, #ffa500 100%)'"><img src="{{ url_for('static', filename='icon/search.png') }}" alt="Generate" style="width:18px; height:18px; filter:brightness(0) invert(1);"></button>
