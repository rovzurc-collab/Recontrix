            // Check if gateway is accessible
            canAccessGateway: function(gatewayName) {
                if (this.isAdmin) return true;
                if (this.allowedGateways.length === 0) return true; // No restrictions = all allowed
                return this.allowedGateways.some(g => g.toUpperCase() === (gatewayName || '').toUpperCase());
            },
            
